---
import Badge from '../Badge.astro';
import { home } from '../../lib/content';
const { about } = home;
---
<section class="about section" id="o-nas">
    <div class="container">
        <div class="about-grid">
            <div class="reveal-left">
                <span class="section-label">{about.label}</span>
                <h2 class="section-title">{about.title}</h2>
                <p class="about-lead">{about.lead}</p>
                <Badge variant="dark">{about.badge}</Badge>
            </div>

            <div class="values-grid reveal-right">
                {about.values.map((v) => (
                    <div class="value-card">
                        <h4>{v.title}</h4>
                        <p>{v.text}</p>
                    </div>
                ))}
            </div>
        </div>
    </div>
</section>

<style>
    .about { background: var(--dark); color: var(--white); }
    .about-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-64);
        align-items: center;
    }
    .about .section-label { color: var(--accent); }
    .about .section-title { color: var(--white); }
    .about-lead {
        font-size: var(--fs-20);
        line-height: var(--leading-1-7);
        color: var(--white-a90);
        margin-bottom: var(--space-24);
    }
    .values-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-16);
    }
    .value-card {
        background: var(--white-a05);
        backdrop-filter: blur(10px);
        border: 1px solid var(--white-a10);
        border-radius: var(--radius-12);
        padding: var(--space-24);
        transition: all var(--duration-300) ease;
    }
    .value-card:hover {
        background: var(--white-a08);
        border-color: var(--white-a20);
        transform: translateY(-4px);
    }
    .value-card h4 {
        font-size: var(--fs-16);
        margin-bottom: var(--space-6);
        transition: color var(--duration-300) ease;
    }
    .value-card:hover h4 { color: var(--accent); }
    .value-card p { font-size: var(--fs-14); color: var(--white-a50); margin: 0; }

    @media (max-width: 1024px) {
        .about-grid { grid-template-columns: 1fr; gap: var(--space-48); }
        .values-grid { grid-template-columns: repeat(4, 1fr); }
    }
    @media (max-width: 768px) {
        .values-grid { grid-template-columns: 1fr; gap: var(--space-12); }
        .value-card { padding: var(--space-20); }
        .value-card h4 { font-size: var(--fs-16); }
        .value-card p { font-size: var(--fs-13); }
    }
</style>
