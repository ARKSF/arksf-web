---
import Badge from '../Badge.astro';
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import { home } from '../../lib/content';

interface Props {
  /** On the About page the title is the page's h1. */
  asPageTitle?: boolean;
  /** Show the "Více o nás" link (home page). */
  more?: boolean;
}
const { asPageTitle = false, more = false } = Astro.props;
const Heading = asPageTitle ? 'h1' : 'h2';
const { about } = home;
---
<section class:list={['about section', asPageTitle && 'about--page']} id="o-nas">
    <div class="container">
        <div class="about-grid">
            <div class="reveal-left">
                <span class="section-label">{about.label}</span>
                <Heading class="section-title">{about.title}</Heading>
                <p class="about-lead">{about.lead}</p>
                <div class="about-actions">
                    <Badge tone="dark" dot>{about.badge}</Badge>
                    {more && <a href={about.more.href} class="about-more">{about.more.label} <Icon name="arrow-right" strokeWidth="2.5" /></a>}
                </div>
            </div>

            <div class="values-grid reveal-right">
                {about.values.map((v) => (
                    <div class="value-card">
                        <h4>{v.title}</h4>
                        <p>{v.text}</p>
                    </div>
                ))}
            </div>
        </div>
    </div>
</section>

<style>
    .about { background: var(--color-surface-inverse); color: var(--color-text-inverse); }
    .about--page { padding-top: calc(var(--header-height) + var(--space-section)); }
    .about-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-16) var(--space-24); }
    .about-more { display: inline-flex; align-items: center; gap: var(--space-8); font-family: var(--font-heading); font-weight: var(--fw-semibold); color: var(--color-text-inverse); transition: gap var(--duration-base) var(--ease-standard); }
    .about-more:hover { gap: var(--space-12); color: var(--color-accent); }
    .about-more :global(svg) { width: 18px; height: 18px; }
    .about-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-64);
        align-items: center;
    }
    .about .section-label { color: var(--color-accent); }
    .about .section-title { color: var(--color-text-inverse); }
    .about-lead {
        font-size: var(--text-xl);
        line-height: var(--leading-relaxed);
        color: var(--color-text-inverse-strong);
        margin-bottom: var(--space-24);
    }
    .values-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-16);
    }
    .value-card {
        background: var(--color-surface-inverse-raised);
        backdrop-filter: blur(10px);
        border: 1px solid var(--color-border-inverse);
        border-radius: var(--radius-md);
        padding: var(--space-24);
        transition: all var(--duration-base) var(--ease-standard);
    }
    .value-card:hover {
        background: var(--color-surface-inverse-raised-hover);
        border-color: var(--color-border-inverse-strong);
        transform: translateY(-4px);
    }
    .value-card h4 {
        font-size: var(--text-base);
        margin-bottom: var(--space-8);
        transition: color var(--duration-base) var(--ease-standard);
    }
    .value-card:hover h4 { color: var(--color-accent); }
    .value-card p { font-size: var(--text-sm); color: var(--color-text-inverse-muted); margin: 0; }

    @media (max-width: 1024px) {
        .about-grid { grid-template-columns: 1fr; gap: var(--space-48); }
        .values-grid { grid-template-columns: repeat(4, 1fr); }
    }
    @media (max-width: 768px) {
        .values-grid { grid-template-columns: 1fr; gap: var(--space-12); }
        .value-card { padding: var(--space-20); }
        .value-card p { font-size: var(--text-sm); }
    }
</style>
