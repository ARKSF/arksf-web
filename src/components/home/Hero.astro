---
import Badge from '../Badge.astro';
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import { home, site } from '../../lib/content';
const { hero } = home;
---
<section class="hero">
    <div class="container">
        <div class="hero-inner">
            <div class="hero-content">
                <Badge variant="hero" class="reveal">{site.district}</Badge>
                <h1 class="reveal delay-1">
                    {hero.titleBefore} <span class="highlight">{hero.titleHighlight}</span> {hero.titleAfter}
                </h1>
                <p class="hero-text reveal delay-2">{hero.text}</p>
                <Button href={hero.cta.href} variant="primary" class="reveal delay-3">
                    {hero.cta.label}
                    <Icon name="arrow-right" strokeWidth="2.5" />
                </Button>
            </div>
            <div class="hero-graphic reveal-right delay-2">
                <svg class="hero-illustration" width="380" height="342" viewBox="0 0 195 175" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect x="25" y="7" width="162" height="160" rx="12" fill="#FAFAFA" stroke="#E5E7EB" stroke-width="0.86"/>
                        <path d="M78.4 72.5s-17.5 29.5-25.7 30.4c-8.1.9-6.4-30.8-12.4-28l-35.1 21.2s21.4 47.5 46.2 45.4c24.8-2.1 52.3-49.7 53.9-52.2 1.6-2.5 2.7-4.8 6.1-3.9 3.4.9.7 6.8.7 6.8l-25.8 63.4H132s15.5-63.1 16.5-67.6c1-4.5 9.2-25.4-33.9-31.7-26.8-3.9-36.2 16.2-36.2 16.2z" fill="url(#heroGrad)"/>
                        <path d="M72.6 38.4c1.5-5.3 8.2-7.5 12.9-4.5 9 5.8 23.4 13.9 40.6 19.1 16.3 5 31.4 5.8 41.6 5.5 5.8-.2 10.7 5.4 9.1 10.9-.6 2.2-2.3 4-4.5 4.5-6.6 1.4-22.2 3.1-48.2-4.1-26.4-7.3-42.7-18.7-49.4-24.2-2.1-1.7-2.9-4.6-2.1-7.2z" stroke="#FC6F6F" stroke-width="0.86" fill="none"/>
                        <circle cx="135.6" cy="37.6" r="11.6" fill="#FC6F6F"/>
                        <defs>
                            <linearGradient id="heroGrad" x1="80.8" y1="52.5" x2="70.5" y2="154" gradientUnits="userSpaceOnUse">
                                <stop stop-color="#7D45E8"/>
                                <stop offset="1" stop-color="#FC6F6F"/>
                            </linearGradient>
                        </defs>
                    </svg>
            </div>
        </div>
    </div>
</section>

<style>
    .hero {
        min-height: 100vh;
        display: flex;
        align-items: center;
        position: relative;
        overflow: hidden;
        padding: var(--space-120) 0 var(--space-80);
        background: var(--bg);
    }
    .hero::before {
        content: '';
        position: absolute;
        top: -20%;
        right: -10%;
        width: 55%;
        height: 140%;
        background: linear-gradient(135deg, var(--soft) 0%, var(--primary-a08) 100%);
        transform: skewX(-12deg);
        z-index: var(--z-base);
    }
    .hero-inner {
        display: grid;
        grid-template-columns: 1.1fr 1fr;
        gap: var(--space-60);
        align-items: center;
        position: relative;
        z-index: var(--z-raised);
    }
    .hero-content { max-width: 580px; }
    .hero h1 {
        font-size: var(--fs-hero);
        line-height: var(--leading-1-1);
        margin-bottom: var(--space-24);
    }
    .hero h1 .highlight {
        background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    .hero-text {
        font-size: var(--fs-17);
        color: var(--gray-600);
        margin-bottom: var(--space-32);
        line-height: var(--leading-1-7);
        max-width: 480px;
    }
    .hero-graphic {
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
    }
    .hero-illustration {
        width: 380px;
        height: auto;
        position: relative;
        z-index: var(--z-raised);
        animation: illustrationFloat var(--duration-float) ease-in-out infinite;
        filter: var(--shadow-illustration);
        transition: transform var(--duration-400) ease, filter var(--duration-400) ease;
    }
    .hero-illustration:hover {
        transform: scale(1.02) translateY(-8px);
        filter: var(--shadow-illustration-hover);
    }
    @keyframes illustrationFloat {
        0%, 100% {
            transform: translateY(0) rotate(0deg);
        }
        50% {
            transform: translateY(-15px) rotate(1deg);
        }
    }

    @media (max-width: 1024px) {
        .hero::before { width: 60%; }
        .hero-inner { gap: var(--space-40); }
    }
    @media (max-width: 900px) {
        .hero::before { display: none; }
        .hero-inner { grid-template-columns: 1fr; }
        .hero-graphic { display: none; }
        .hero h1 { font-size: var(--fs-hero-narrow); }
    }
    @media (max-width: 768px) {
        .hero { padding: var(--space-100) 0 var(--space-60); }
    }
</style>
