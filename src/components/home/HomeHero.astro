---
// Home page hero. Fifteen variants from three design rounds live in ./hero/:
//   1–6   HeroRound1  (ilustrace, fotka, split, tmavá, koláž, typografie)
//   7–12  HeroRound2  (oblouk, cesta, ilustrace XXL, editorial, kino, logo)
//   13–15 HeroRound3  (bento, tým, panorama)
//   16    HeroRound4  (lomítka) built on the // mark
// The live site renders only the number in src/data/home.json → "hero.variant".
// With PUBLIC_DESIGN_TOOLS=1 all fifteen are rendered and a switcher (bottom left) flips between them.
import HeroRound1 from './hero/HeroRound1.astro';
import HeroRound2 from './hero/HeroRound2.astro';
import HeroRound3 from './hero/HeroRound3.astro';
import HeroRound4 from './hero/HeroRound4.astro';
import { home } from '../../lib/content';

const chosen = home.hero.variant ?? 13;
const tools = import.meta.env.PUBLIC_DESIGN_TOOLS === '1';
const NAMES = ['Ilustrace', 'Fotka', 'Split', 'Tmavá', 'Koláž', 'Typografie', 'Oblouk', 'Cesta', 'Ilustrace XXL', 'Editorial', 'Kino', 'Logo', 'Bento', 'Tým', 'Panorama', 'Lomítka'];
---
<HeroRound1 offset={0} chosen={chosen} />
<HeroRound2 offset={6} chosen={chosen} />
<HeroRound3 offset={12} chosen={chosen} />
<HeroRound4 offset={15} chosen={chosen} />

{tools && (
    <div class="hero-switcher" role="group" aria-label="Varianta hero">
        <span class="hero-switcher-label">Hero <strong data-hero-name>{NAMES[chosen - 1]}</strong></span>
        <div class="hero-switcher-buttons">
            {NAMES.map((name, i) => <button type="button" data-hero-pick={i + 1} data-name={name} title={name} aria-pressed={i + 1 === chosen ? 'true' : 'false'}>{i + 1}</button>)}
        </div>
    </div>
)}

<script>
    const picks = document.querySelectorAll('[data-hero-pick]');
    if (picks.length) {
        const label = document.querySelector('[data-hero-name]');
        const show = (v) => {
            document.querySelectorAll('[data-hero]').forEach((s) => { s.hidden = s.dataset.hero !== String(v); });
            picks.forEach((b) => {
                const on = b.dataset.heroPick === String(v);
                b.setAttribute('aria-pressed', String(on));
                if (on && label) label.textContent = b.dataset.name;
            });
            try { localStorage.setItem('ark-hero', String(v)); } catch {}
            const url = new URL(location.href); url.searchParams.set('hero', String(v)); history.replaceState(null, '', url);
        };
        picks.forEach((b) => b.addEventListener('click', () => show(b.dataset.heroPick)));
        let start = new URL(location.href).searchParams.get('hero');
        if (!start) { try { start = localStorage.getItem('ark-hero'); } catch {} }
        if (start && document.querySelector(`[data-hero="${start}"]`)) show(start);
    }
</script>

<style>
    .hero-switcher {
        position: fixed;
        left: var(--space-16);
        bottom: var(--space-16);
        z-index: var(--z-modal);
        display: flex;
        align-items: center;
        gap: var(--space-8);
        max-width: calc(100vw - var(--space-32));
        padding: var(--space-8);
        background: var(--color-surface-inverse);
        color: var(--color-text-inverse);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-xl);
        font-family: var(--font-heading);
        font-size: var(--text-sm);
    }
    .hero-switcher-label { padding: 0 var(--space-8); color: var(--color-text-inverse-muted); white-space: nowrap; }
    .hero-switcher-label strong { color: var(--color-text-inverse); }
    .hero-switcher-buttons { display: flex; flex-wrap: wrap; gap: var(--space-4); }
    .hero-switcher button {
        width: 32px; height: 32px;
        border-radius: var(--radius-round);
        border: 0;
        background: var(--color-fill-inverse);
        color: var(--color-text-inverse);
        font: inherit;
        font-weight: var(--fw-semibold);
        cursor: pointer;
    }
    .hero-switcher button:nth-child(7), .hero-switcher button:nth-child(13), .hero-switcher button:nth-child(16) { margin-left: var(--space-8); }
    .hero-switcher button[aria-pressed="true"] { background: var(--color-accent); color: var(--color-text-on-accent); }
    @media (max-width: 768px) {
        .hero-switcher { flex-direction: column; align-items: flex-start; }
        .hero-switcher button:nth-child(7), .hero-switcher button:nth-child(13), .hero-switcher button:nth-child(16) { margin-left: 0; }
    }
</style>
