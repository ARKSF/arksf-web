---
import { home } from '../../lib/content';
const { quote } = home;
---
<section class="quote-section">
    <div class="container">
        <div class="quote-content reveal-scale">
            <span class="quote-marks">"</span>
            <p class="quote-text">{quote.text}</p>
            <span class="quote-marks quote-marks-end">"</span>
            <div class="quote-signature">{quote.signature}</div>
        </div>
    </div>
</section>

<style>
    .quote-section {
        background: var(--dark);
        padding: var(--space-56) 0;
        position: relative;
        overflow: hidden;
    }
    .quote-content {
        text-align: center;
        max-width: 700px;
        margin: 0 auto;
        position: relative;
        z-index: var(--z-raised);
    }
    .quote-marks {
        font-family: var(--font-heading);
        font-size: var(--fs-48);
        font-weight: var(--fw-bold);
        color: var(--accent);
        line-height: var(--leading-0-5);
        display: block;
    }
    .quote-marks-end {
        line-height: var(--leading-1);
        margin-top: var(--space-8);
    }
    .quote-text {
        font-family: var(--font-heading);
        font-size: var(--fs-quote);
        font-weight: var(--fw-semibold);
        color: var(--white);
        line-height: var(--leading-1-5);
        margin: var(--space-12) 0;
    }
    .quote-signature {
        font-family: var(--font-body);
        font-size: var(--fs-14);
        font-weight: var(--fw-regular);
        color: var(--white-a50);
        margin-top: var(--space-16);
    }

    @media (max-width: 768px) {
        .quote-section { padding: var(--space-40) 0; }
        .quote-text { font-size: var(--fs-18); }
        .quote-marks { font-size: var(--fs-36); }
    }
</style>
