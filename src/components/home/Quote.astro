---
import { home } from '../../lib/content';
const { quote } = home;
---
<section class="quote-section">
    <div class="container">
        <div class="quote-content reveal-scale">
            <span class="quote-marks">"</span>
            <p class="quote-text">{quote.text}</p>
            <span class="quote-marks quote-marks-end">"</span>
            <div class="quote-signature">{quote.signature}</div>
        </div>
    </div>
</section>

<style>
    .quote-section {
        background: var(--dark);
        padding: 56px 0;
        position: relative;
        overflow: hidden;
    }
    .quote-content {
        text-align: center;
        max-width: 700px;
        margin: 0 auto;
        position: relative;
        z-index: 1;
    }
    .quote-marks {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 48px;
        font-weight: 700;
        color: var(--accent);
        line-height: 0.5;
        display: block;
    }
    .quote-marks-end {
        line-height: 1;
        margin-top: 8px;
    }
    .quote-text {
        font-family: 'Space Grotesk', sans-serif;
        font-size: clamp(20px, 3vw, 24px);
        font-weight: 600;
        color: var(--white);
        line-height: 1.5;
        margin: 12px 0;
    }
    .quote-signature {
        font-family: 'Manrope', sans-serif;
        font-size: 14px;
        font-weight: 400;
        color: rgba(255,255,255,0.5);
        margin-top: 16px;
    }

    @media (max-width: 768px) {
        .quote-section { padding: 40px 0; }
        .quote-text { font-size: 18px; }
        .quote-marks { font-size: 36px; }
    }
</style>
