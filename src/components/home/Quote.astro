---
import { home } from '../../lib/content';
const { quote } = home;
---
<section class="quote-section">
    <div class="container">
        <div class="quote-content reveal-scale">
            <span class="quote-marks">"</span>
            <p class="quote-text">{quote.text}</p>
            <span class="quote-marks quote-marks-end">"</span>
            <div class="quote-signature">{quote.signature}</div>
        </div>
    </div>
</section>

<style>
    .quote-section {
        background: var(--color-surface-inverse);
        padding: var(--space-48) 0;
        position: relative;
        overflow: hidden;
    }
    .quote-content {
        text-align: center;
        max-width: 700px;
        margin: 0 auto;
        position: relative;
        z-index: var(--z-raised);
    }
    .quote-marks {
        font-family: var(--font-heading);
        font-size: var(--text-4xl);
        font-weight: var(--fw-bold);
        color: var(--color-accent);
        line-height: var(--leading-collapse);
        display: block;
    }
    .quote-marks-end {
        line-height: var(--leading-none);
        margin-top: var(--space-8);
    }
    .quote-text {
        font-family: var(--font-heading);
        font-size: var(--text-2xl);
        font-weight: var(--fw-semibold);
        color: var(--color-text-inverse);
        line-height: var(--leading-normal);
        margin: var(--space-12) 0;
    }
    .quote-signature {
        font-family: var(--font-body);
        font-size: var(--text-sm);
        font-weight: var(--fw-regular);
        color: var(--color-text-inverse-muted);
        margin-top: var(--space-16);
    }

    @media (max-width: 768px) {
        .quote-section { padding: var(--space-40) 0; }
        .quote-text { font-size: var(--text-lg); }
        .quote-marks { font-size: var(--text-3xl); }
    }
</style>
