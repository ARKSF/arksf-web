---
// Price card: icon, label, title, description, a list of <PricingItem>s (slot) and an optional footer note.
// `featured` = dark card with a coral badge.
import Icon from '../Icon.astro';
import type { IconName } from '../icons';

interface Props {
  icon: IconName;
  label: string;
  title: string;
  description: string;
  featured?: boolean;
  badge?: string;
  footer?: string;
  class?: string;
}

const { icon, label, title, description, featured = false, badge, footer, class: className } = Astro.props;
---
<div class:list={['pricing-card', { featured }, className]}>
    {badge && <div class="pricing-badge">{badge}</div>}
    <div class="pricing-card-icon">
        <Icon name={icon} />
    </div>
    <div class="pricing-card-header">
        <span class="pricing-label">{label}</span>
        <h3>{title}</h3>
        <p class="pricing-desc">{description}</p>
    </div>
    <div class="pricing-card-body">
        <slot />
    </div>
    {footer && (
        <div class="pricing-card-footer">
            <p>{footer}</p>
        </div>
    )}
</div>

<style>
    .pricing-card {
        background: var(--color-surface-alt);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        padding: var(--space-32);
        position: relative;
        transition: all var(--duration-slow) var(--ease-standard);
    }
    .pricing-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-lg);
    }
    .pricing-card.featured {
        background: var(--color-surface-inverse);
        border-color: var(--color-surface-inverse);
    }
    .pricing-card.featured .pricing-label,
    .pricing-card.featured h3 {
        color: var(--color-text-inverse);
    }
    .pricing-card.featured .pricing-desc,
    .pricing-card.featured .pricing-card-footer p {
        color: var(--color-text-inverse-muted);
    }
    .pricing-badge {
        position: absolute;
        top: -12px;
        left: 32px;
        background: var(--color-accent);
        color: var(--color-text-on-accent);
        font-size: var(--text-xs);
        font-weight: var(--fw-semibold);
        padding: var(--space-8) var(--space-12);
        border-radius: var(--radius-lg);
    }
    .pricing-card-icon {
        width: 56px;
        height: 56px;
        background: var(--color-brand-subtle);
        border-radius: var(--radius-md);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: var(--space-20);
        transition: all var(--duration-base) var(--ease-standard);
    }
    .pricing-card:hover .pricing-card-icon {
        transform: scale(1.05);
    }
    .pricing-card-icon svg {
        width: 26px;
        height: 26px;
        color: var(--color-brand);
    }
    .pricing-card.featured .pricing-card-icon {
        background: var(--color-fill-inverse);
    }
    .pricing-card.featured .pricing-card-icon svg {
        color: var(--color-accent);
    }
    .pricing-card-header {
        margin-bottom: var(--space-24);
    }
    .pricing-label {
        font-family: var(--font-heading);
        font-size: var(--text-xs);
        font-weight: var(--fw-semibold);
        text-transform: uppercase;
        letter-spacing: var(--tracking-label);
        color: var(--color-brand);
        margin-bottom: var(--space-8);
        display: block;
    }
    .pricing-card-header h3 {
        font-size: var(--text-2xl);
        margin-bottom: var(--space-8);
    }
    .pricing-desc {
        color: var(--color-text-muted);
        font-size: var(--text-sm);
        line-height: var(--leading-relaxed);
    }
    .pricing-card-body {
        margin-bottom: var(--space-20);
    }
    .pricing-card-footer p {
        font-size: var(--text-sm);
        color: var(--color-text-muted);
        line-height: var(--leading-relaxed);
    }

    @media (max-width: 768px) {
        .pricing-card { padding: var(--space-24); }
    }
</style>
