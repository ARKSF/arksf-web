---
// Home: the three ways to work with ARK as photo tiles, each linking to its part of the Spolupráce page.
// Starting prices come from src/data/pricing.json, photos from src/data/photos.json.
import SectionHeader from '../SectionHeader.astro';
import Photo from '../Photo.astro';
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import { home, pricing, photos, price } from '../../lib/content';

const { paths } = home;
const from: Record<string, { value: number; unit: string }> = {
  consultations: { value: Math.min(...pricing.consultations.items.map((i) => i.price)), unit: '' },
  trainings: { value: Math.min(...pricing.trainings.items.map((i) => i.price)), unit: pricing.trainings.unit },
  group: { value: pricing.group.price, unit: pricing.group.unit },
};
---
<section class="paths section" id="spoluprace">
    <div class="container">
        <SectionHeader label={paths.label} title={paths.title} subtitle={paths.subtitle} />
        <div class="paths-grid">
            {paths.items.map((item, i) => (
                <a href={`spoluprace.html#${item.id}`} class={`path-card reveal delay-${i + 1}`}>
                    <Photo file={(photos as Record<string, unknown>)[item.id] as string} alt={item.title} label={item.photoLabel} ratio="4 / 3" sizes="(max-width: 900px) 100vw, 360px" widths={[360, 540, 720]} class="path-photo" />
                    <div class="path-body">
                        <h3>{item.title}</h3>
                        <p>{item.text}</p>
                        <div class="path-foot">
                            <span class="path-price">od {price(from[item.from].value)} <small>{from[item.from].unit}</small></span>
                            <span class="path-arrow" aria-hidden="true"><Icon name="arrow-right" strokeWidth="2.5" /></span>
                        </div>
                    </div>
                </a>
            ))}
        </div>
        <div class="paths-more">
            <Button href="spoluprace.html" variant="secondary">{paths.action} <Icon name="arrow-right" strokeWidth="2.5" /></Button>
        </div>
    </div>
</section>

<style>
    .paths { background: var(--color-surface-alt); }
    .paths-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--space-grid-gap);
    }
    .path-card {
        display: flex;
        flex-direction: column;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        overflow: hidden;
        transition: all var(--duration-base) var(--ease-standard);
    }
    .path-card:hover {
        transform: translateY(-6px);
        box-shadow: var(--shadow-lg);
        border-color: var(--color-brand);
    }
    .path-card:focus-visible { outline: none; box-shadow: var(--focus-ring); }
    .path-card :global(.path-photo) { border-radius: 0; }
    .path-card :global(.path-photo img) { transition: transform var(--duration-reveal) var(--ease-standard); }
    .path-card:hover :global(.path-photo img) { transform: scale(1.04); }
    .path-body {
        display: flex;
        flex-direction: column;
        flex: 1;
        padding: var(--space-24);
    }
    .path-body h3 { font-size: var(--text-xl); margin-bottom: var(--space-8); }
    .path-body p { color: var(--color-text-muted); margin-bottom: var(--space-24); }
    .path-foot {
        margin-top: auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: var(--space-16);
        border-top: 1px solid var(--color-border);
    }
    .path-price {
        font-family: var(--font-heading);
        font-weight: var(--fw-bold);
        font-size: var(--text-lg);
        color: var(--color-brand);
    }
    .path-price small { font-size: var(--text-sm); font-weight: var(--fw-medium); color: var(--color-text-muted); }
    .path-arrow {
        width: 40px; height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: var(--radius-round);
        background: var(--color-brand-subtle);
        color: var(--color-brand);
        transition: all var(--duration-base) var(--ease-standard);
    }
    .path-arrow :global(svg) { width: 18px; height: 18px; }
    .path-card:hover .path-arrow { background: var(--color-brand); color: var(--color-text-inverse); }
    .paths-more { display: flex; justify-content: center; margin-top: var(--space-40); }

    @media (max-width: 900px) {
        .paths-grid { grid-template-columns: 1fr; max-width: 560px; margin: 0 auto; }
    }
</style>
