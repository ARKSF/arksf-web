---
// Home: the three ways to work with ARK as tall photos cut on the "//" slant, text below each photo.
// The cut is a fixed pixel offset (--slant), so the gaps stay parallel when a hovered panel widens.
// On phones the panels stack.
// Each panel links to its part of the Spolupráce page. Photos from src/data/photos.json.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import SectionHeader from '../SectionHeader.astro';
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import { home, photos } from '../../lib/content';

const { paths } = home;
const all = import.meta.glob<{ default: ImageMetadata }>('../../assets/photos/*.{jpg,jpeg,png,webp}', { eager: true });
const pic = (f: string) => {
  const hit = all[`../../assets/photos/${f}`];
  if (!hit) throw new Error(`Photo "${f}" not found in src/assets/photos/`);
  return hit.default;
};
const fileFor: Record<string, string> = { konzultace: photos.konzultace, treninky: photos.treninky, skupinove: photos.skupinove };
---
<section class="paths section" id="spoluprace">
    <div class="container">
        <SectionHeader label={paths.label} title={paths.title} subtitle={paths.subtitle} />
        <div class="panels">
            {paths.items.map((item, i) => (
                <a href={`spoluprace.html#${item.id}`} class={`panel panel--${i + 1} reveal delay-${i + 1}`}>
                    <span class="panel-photo"><Image src={pic(fileFor[item.id])} alt="" widths={[640, 960, 1280, 1600]} sizes="(max-width: 900px) 100vw, 620px" quality={85} /></span>
                    <span class="panel-body">
                        <span class="panel-num">0{i + 1} //</span>
                        <span class="panel-title">{item.title}</span>
                        <span class="panel-text">{item.text}</span>
                        <span class="panel-more">{paths.more} <Icon name="arrow-right" strokeWidth="2.5" /></span>
                    </span>
                </a>
            ))}
        </div>
        <div class="paths-more">
            <Button href="spoluprace.html" variant="secondary">{paths.action} <Icon name="arrow-right" strokeWidth="2.5" /></Button>
        </div>
    </div>
</section>

<style>
    .paths { background: var(--color-surface-alt); }
    .panels { display: flex; align-items: flex-start; }
    .panel {
        flex: 1 1 0;
        min-width: 0;
        display: flex;
        flex-direction: column;
        color: var(--color-text);
        margin-left: calc(var(--space-16) - var(--slant));
        transition: flex-grow var(--duration-slow) var(--ease-standard);
    }
    .panel:first-child { margin-left: 0; }
    .panel:hover, .panel:focus-visible { flex-grow: 1.5; outline: none; }
    .panel-photo {
        position: relative;
        display: block;
        height: min(440px, 56vh);
        overflow: hidden;
        clip-path: polygon(var(--slant) 0, 100% 0, calc(100% - var(--slant)) 100%, 0 100%);
    }
    .panel:first-child .panel-photo { clip-path: polygon(0 0, 100% 0, calc(100% - var(--slant)) 100%, 0 100%); }
    .panel:last-child .panel-photo { clip-path: polygon(var(--slant) 0, 100% 0, 100% 100%, 0 100%); }
    .panel-photo :global(img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform var(--duration-reveal) var(--ease-standard);
    }
    .panel:hover .panel-photo :global(img), .panel:focus-visible .panel-photo :global(img) { transform: scale(1.04); }
    .panel--1 .panel-photo :global(img) { object-position: 35% center; }
    .panel--2 .panel-photo :global(img) { object-position: center 40%; }
    .panel--3 .panel-photo :global(img) { object-position: 55% center; }
    .panel-body {
        display: flex;
        flex-direction: column;
        gap: var(--space-8);
        padding: var(--space-24) var(--space-48) 0 0;
    }
    .panel:not(:first-child) .panel-body { padding-left: var(--space-16); }
    .panel-num { font-family: var(--font-heading); font-weight: var(--fw-bold); font-size: var(--text-sm); color: var(--color-brand); letter-spacing: var(--tracking-label); }
    .panel-title { font-family: var(--font-heading); font-weight: var(--fw-bold); font-size: var(--text-xl); line-height: var(--leading-snug); transition: color var(--duration-base) var(--ease-standard); }
    .panel-text { color: var(--color-text-muted); }
    .panel-more { display: inline-flex; align-items: center; gap: var(--space-8); margin-top: var(--space-4); font-family: var(--font-heading); font-weight: var(--fw-semibold); color: var(--color-brand); }
    .panel-more :global(svg) { width: 18px; height: 18px; transition: transform var(--duration-base) var(--ease-standard); }
    .panel:hover .panel-title, .panel:focus-visible .panel-title { color: var(--color-brand); }
    .panel:hover .panel-more :global(svg), .panel:focus-visible .panel-more :global(svg) { transform: translateX(4px); }
    .panel:focus-visible .panel-photo { box-shadow: var(--focus-ring); }
    .paths-more { display: flex; justify-content: center; margin-top: var(--space-48); }

    @media (max-width: 900px) {
        .panels { flex-direction: column; gap: var(--space-40); }
        .panel, .panel:first-child { flex: none; width: 100%; margin-left: 0; }
        .panel-photo, .panel:first-child .panel-photo, .panel:last-child .panel-photo {
            height: 260px;
            clip-path: polygon(0 0, 100% 0, calc(100% - var(--slant)) 100%, 0 100%);
        }
        .panel-body, .panel:not(:first-child) .panel-body { padding: var(--space-16) 0 0; }
    }
</style>
