---
import { home } from '../../lib/content';
const { approach } = home;
---
<section class="approach section" id="pristup">
    <div class="container">
        <div class="approach-grid">
            <div class="reveal-left">
                <span class="section-label">{approach.label}</span>
                <h2 class="section-title">{approach.title}</h2>
                {approach.paragraphs.map((text) => <p class="approach-text">{text}</p>)}
            </div>
            <div class="reveal-right">
                <ul class="approach-list">
                    {approach.points.map((point) => (
                        <li>
                            <div class="approach-list-label">//</div>
                            <h4>{point.title}</h4>
                            <p>{point.text}</p>
                        </li>
                    ))}
                </ul>
            </div>
        </div>
    </div>
</section>

<style>
    .approach { background: var(--color-surface-alt); }
    .approach-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-80);
        align-items: start;
    }
    .approach-text {
        font-size: var(--text-lg);
        line-height: var(--leading-relaxed);
        color: var(--color-text-muted);
        margin-bottom: var(--space-24);
    }
    .approach-list {
        list-style: none;
    }
    .approach-list li {
        padding: var(--space-24) 0;
        border-bottom: 1px solid var(--color-border);
        transition: all var(--duration-base) var(--ease-standard);
    }
    .approach-list li:first-child {
        border-top: 1px solid var(--color-border);
    }
    .approach-list li:hover {
        padding-left: var(--space-8);
    }
    .approach-list-label {
        font-family: var(--font-heading);
        font-weight: var(--fw-bold);
        color: var(--color-brand);
        font-size: var(--text-sm);
        margin-bottom: var(--space-8);
    }
    .approach-list h4 {
        font-size: var(--text-lg);
        margin-bottom: var(--space-8);
        transition: color var(--duration-base) var(--ease-standard);
    }
    .approach-list li:hover h4 {
        color: var(--color-brand);
    }
    .approach-list p {
        color: var(--color-text-muted);
        font-size: var(--text-base);
        line-height: var(--leading-relaxed);
        margin: 0;
    }

    @media (max-width: 900px) {
        .approach-grid { grid-template-columns: 1fr; gap: var(--space-48); }
    }
</style>
