---
// One price row inside a <PricingCard>. With `details` it becomes an accordion: tap to show the text.
import Icon from '../Icon.astro';
import { price as formatPrice } from '../../lib/content';

interface Props {
  title: string;
  meta: string;
  price: number;
  unit?: string;
  details?: string;
}

const { title, meta, price, unit, details } = Astro.props;
---
{details ? (
    <div class="pricing-item has-desc">
        <div class="pricing-item-header">
            <div class="pricing-item-info">
                <h4>{title}</h4>
                <span>{meta}</span>
            </div>
            <div class="pricing-item-toggle">
                <div class="pricing-item-price">{unit ? <>{`${formatPrice(price)} `}<span>{unit}</span></> : formatPrice(price)}</div>
                <Icon name="chevron-down" class="pricing-item-arrow" />
            </div>
        </div>
        <p class="pricing-item-desc">{details}</p>
    </div>
) : (
    <div class="pricing-item">
        <div class="pricing-item-info">
            <h4>{title}</h4>
            <span>{meta}</span>
        </div>
        <div class="pricing-item-price">{unit ? <>{`${formatPrice(price)} `}<span>{unit}</span></> : formatPrice(price)}</div>
    </div>
)}

<script>
    document.querySelectorAll('.pricing-item.has-desc').forEach((item) => {
        item.addEventListener('click', () => item.classList.toggle('active'));
    });
</script>

<style>
    .pricing-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: var(--space-16) 0;
        border-bottom: 1px solid var(--gray-200);
    }
    .pricing-item:last-child {
        border-bottom: none;
    }
    .pricing-item h4 {
        font-size: var(--fs-15);
        margin-bottom: var(--space-2);
    }
    .pricing-item span {
        font-size: var(--fs-13);
        color: var(--gray-600);
    }
    .pricing-item-price {
        font-family: var(--font-heading);
        font-size: var(--fs-18);
        font-weight: var(--fw-bold);
        color: var(--primary);
        white-space: nowrap;
    }
    .pricing-item-price span {
        font-size: var(--fs-13);
        font-weight: var(--fw-medium);
        color: var(--gray-600);
    }
    .pricing-item.has-desc {
        flex-direction: column;
        align-items: stretch;
        cursor: pointer;
    }
    .pricing-item-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
    }
    .pricing-item-toggle {
        display: flex;
        align-items: center;
        gap: var(--space-12);
    }
    .pricing-item-arrow {
        width: 20px;
        height: 20px;
        color: var(--primary);
        transition: transform var(--duration-300) ease;
        flex-shrink: 0;
    }
    .pricing-item.has-desc.active .pricing-item-arrow {
        transform: rotate(180deg);
    }
    .pricing-item-desc {
        font-size: var(--fs-13);
        color: var(--gray-600);
        line-height: var(--leading-1-6);
        margin: 0;
        max-height: 0;
        overflow: hidden;
        transition: max-height var(--duration-300) ease, margin-top var(--duration-300) ease;
    }
    .pricing-item.has-desc.active .pricing-item-desc {
        max-height: 200px;
        margin-top: var(--space-12);
    }

    /* inside a featured (dark) card */
    :global(.pricing-card.featured) .pricing-item h4 {
        color: var(--white);
    }
    :global(.pricing-card.featured) .pricing-item span {
        color: var(--white-a60);
    }
    :global(.pricing-card.featured) .pricing-item-price {
        color: var(--accent);
    }
    :global(.pricing-card.featured) .pricing-item-price span {
        color: var(--white-a50);
    }
    :global(.pricing-card.featured) .pricing-item {
        border-color: var(--white-a10);
    }
</style>
