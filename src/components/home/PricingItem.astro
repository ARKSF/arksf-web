---
// One price row inside a <PricingCard>. With `details` it becomes an accordion: tap to show the text.
import Icon from '../Icon.astro';
import { price as formatPrice } from '../../lib/content';

interface Props {
  title: string;
  meta: string;
  price: number;
  unit?: string;
  details?: string;
}

const { title, meta, price, unit, details } = Astro.props;
const detailsId = `price-details-${title.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-')}`;
---
{details ? (
    <div class="pricing-item has-desc">
        <div class="pricing-item-header">
            <div class="pricing-item-info">
                <h4><button type="button" class="pricing-item-button" aria-expanded="false" aria-controls={detailsId}>{title}</button></h4>
                <span>{meta}</span>
            </div>
            <div class="pricing-item-toggle">
                <div class="pricing-item-price">{unit ? <>{`${formatPrice(price)} `}<span>{unit}</span></> : formatPrice(price)}</div>
                <Icon name="chevron-down" class="pricing-item-arrow" />
            </div>
        </div>
        <p class="pricing-item-desc" id={detailsId}>{details}</p>
    </div>
) : (
    <div class="pricing-item">
        <div class="pricing-item-info">
            <h4>{title}</h4>
            <span>{meta}</span>
        </div>
        <div class="pricing-item-price">{unit ? <>{`${formatPrice(price)} `}<span>{unit}</span></> : formatPrice(price)}</div>
    </div>
)}

<script>
    // The title is a real button stretched over the whole row; clicks anywhere on the row land on it
    document.querySelectorAll('.pricing-item.has-desc').forEach((item) => {
        const button = item.querySelector('.pricing-item-button');
        item.addEventListener('click', () => {
            const open = item.classList.toggle('active');
            button?.setAttribute('aria-expanded', String(open));
        });
    });
</script>

<style>
    .pricing-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: var(--space-16) 0;
        border-bottom: 1px solid var(--color-border);
    }
    .pricing-item:last-child {
        border-bottom: none;
    }
    .pricing-item h4 {
        font-size: var(--text-base);
        margin-bottom: var(--space-4);
    }
    .pricing-item span {
        font-size: var(--text-sm);
        color: var(--color-text-muted);
    }
    .pricing-item-price {
        font-family: var(--font-heading);
        font-size: var(--text-lg);
        font-weight: var(--fw-bold);
        color: var(--color-brand);
        white-space: nowrap;
    }
    .pricing-item-price span {
        font-size: var(--text-sm);
        font-weight: var(--fw-medium);
        color: var(--color-text-muted);
    }
    .pricing-item.has-desc {
        flex-direction: column;
        align-items: stretch;
        cursor: pointer;
        position: relative;
    }
    .pricing-item-button {
        font: inherit;
        color: inherit;
        background: none;
        border: 0;
        padding: 0;
        margin: 0;
        text-align: inherit;
        cursor: inherit;
        appearance: none;
        display: inline;
    }
    .pricing-item-button::after {
        content: '';
        position: absolute;
        inset: 0;
    }
    .pricing-item-button:focus { outline: none; }
    .pricing-item.has-desc:has(.pricing-item-button:focus-visible) {
        outline: 3px solid var(--color-brand);
        outline-offset: 3px;
    }
    .pricing-item-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
    }
    .pricing-item-toggle {
        display: flex;
        align-items: center;
        gap: var(--space-12);
    }
    .pricing-item-arrow {
        width: 20px;
        height: 20px;
        color: var(--color-brand);
        transition: transform var(--duration-base) var(--ease-standard);
        flex-shrink: 0;
    }
    .pricing-item.has-desc.active .pricing-item-arrow {
        transform: rotate(180deg);
    }
    .pricing-item-desc {
        font-size: var(--text-sm);
        color: var(--color-text-muted);
        line-height: var(--leading-relaxed);
        margin: 0;
        max-height: 0;
        overflow: hidden;
        transition: max-height var(--duration-base) var(--ease-standard), margin-top var(--duration-base) var(--ease-standard);
    }
    .pricing-item.has-desc.active .pricing-item-desc {
        max-height: 200px;
        margin-top: var(--space-12);
    }

    /* inside a featured (dark) card */
    :global(.pricing-card.featured) .pricing-item h4 {
        color: var(--color-text-inverse);
    }
    :global(.pricing-card.featured) .pricing-item span {
        color: var(--color-text-inverse-muted);
    }
    :global(.pricing-card.featured) .pricing-item-price {
        color: var(--color-accent);
    }
    :global(.pricing-card.featured) .pricing-item-price span {
        color: var(--color-text-inverse-muted);
    }
    :global(.pricing-card.featured) .pricing-item {
        border-color: var(--color-border-inverse);
    }
</style>
