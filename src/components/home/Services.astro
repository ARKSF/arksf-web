---
import SectionHeader from '../SectionHeader.astro';
import Icon from '../Icon.astro';
import { home } from '../../lib/content';
const { services } = home;
---
<section class="services section" id="sluzby">
    <div class="container">
        <SectionHeader label={services.label} title={services.title} subtitle={services.subtitle} />

        <div class="services-grid">
            {services.items.map((item, i) => (
                <div class={`service-card reveal delay-${i + 1}`}>
                    <div class="service-icon">
                        <Icon name={item.icon as any} />
                    </div>
                    <h3>{item.title}</h3>
                    <p>{item.text}</p>
                </div>
            ))}
        </div>
    </div>
</section>

<style>
    .services { background: var(--color-surface); }
    .services-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--space-24);
    }
    .service-card {
        background: var(--color-surface-alt);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        padding: var(--space-32);
        transition: all var(--duration-slow) var(--ease-standard);
    }
    .service-card:hover {
        transform: translateY(-8px);
        box-shadow: var(--shadow-lg);
        border-color: var(--color-brand);
    }
    .service-icon {
        width: 48px; height: 48px;
        background: var(--color-brand-subtle);
        border-radius: var(--radius-sm);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: var(--space-16);
        transition: all var(--duration-base) var(--ease-standard);
    }
    .service-card:hover .service-icon {
        background: var(--color-brand);
        transform: scale(1.1);
    }
    .service-icon svg {
        width: 24px; height: 24px;
        color: var(--color-brand);
        transition: color var(--duration-base) var(--ease-standard);
    }
    .service-card:hover .service-icon svg { color: var(--color-text-inverse); }
    .service-card h3 {
        font-size: var(--text-lg);
        margin-bottom: var(--space-8);
        transition: color var(--duration-base) var(--ease-standard);
    }
    .service-card:hover h3 { color: var(--color-brand); }
    .service-card p { color: var(--color-text-muted); font-size: var(--text-base); }

    @media (max-width: 900px) {
        .services-grid { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 768px) {
        .services-grid { grid-template-columns: 1fr; }
    }
</style>
