---
// Contact: address, e-mail, opening hours (src/data/site.json) and the message form.
import Icon from '../Icon.astro';
import ContactForm from './ContactForm.astro';
import { home, site } from '../../lib/content';
const { contact } = home;
---
<section class="section" id="kontakt">
    <div class="container">
        <div class="contact-grid">
            <div class="contact-info reveal-left">
                <span class="section-label">{contact.label}</span>
                <h2>{contact.title}</h2>
                <p>{site.replyPromise}</p>

                <ul class="contact-list">
                    <li>
                        <div class="contact-list-icon">
                            <Icon name="map-pin" />
                        </div>
                        <div>
                            <h4>Adresa</h4>
                            <p><a href={site.address.mapsUrl} target="_blank" rel="noopener" class="address-link">{site.address.full}</a></p>
                            <p class="contact-note">{site.address.transport}<br>{site.address.parking}</p>
                        </div>
                    </li>
                    <li>
                        <div class="contact-list-icon">
                            <Icon name="mail" />
                        </div>
                        <div>
                            <h4>Email</h4>
                            <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
                        </div>
                    </li>
                    <li>
                        <div class="contact-list-icon">
                            <Icon name="clock-hands" />
                        </div>
                        <div>
                            <h4>Otevírací doba</h4>
                            {site.hours.map((h) => <p>{h.days} {h.time}</p>)}
                        </div>
                    </li>
                </ul>
            </div>

            <ContactForm class="reveal-right" />
        </div>
    </div>
</section>

<style>
    .contact-grid {
        display: grid;
        grid-template-columns: 1fr 1.1fr;
        gap: 48px;
        align-items: start;
    }
    .contact-info h2 { font-size: 28px; margin-bottom: 12px; }
    .contact-info > p { color: var(--gray-600); margin-bottom: 32px; }
    .contact-list { list-style: none; }
    .contact-list li {
        display: flex;
        align-items: flex-start;
        gap: 16px;
        margin-bottom: 16px;
        padding: 12px;
        border-radius: 12px;
        transition: background 0.3s ease;
        margin-left: -12px;
    }
    .contact-list li:hover { background: rgba(124, 58, 237, 0.05); }
    .contact-list-icon {
        width: 40px; height: 40px;
        background: var(--soft);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        margin-top: 2px;
        transition: all 0.3s ease;
    }
    .contact-list li:hover .contact-list-icon {
        background: var(--primary);
        transform: scale(1.05);
    }
    .contact-list-icon svg {
        width: 18px; height: 18px;
        color: var(--primary);
        transition: color 0.3s ease;
    }
    .contact-list li:hover .contact-list-icon svg { color: var(--white); }
    .contact-list h4 { font-size: 14px; margin-bottom: 2px; }
    .contact-list p { color: var(--gray-600); font-size: 14px; margin: 0; }
    .contact-list p.contact-note { font-size: 13px; margin-top: 4px; }
    .contact-list a.address-link {
        color: inherit;
        text-decoration: none;
        border-bottom: 1px dashed var(--gray-200);
        transition: all 0.3s ease;
    }
    .contact-list a.address-link:hover {
        color: var(--primary);
        border-bottom-color: var(--primary);
    }
    .hours-grid {
        display: grid;
        grid-template-columns: auto auto;
        gap: 4px 16px;
        margin-top: 4px;
    }
    .hours-day {
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 600;
        font-size: 13px;
        color: var(--dark);
    }
    .hours-time {
        font-size: 13px;
        color: var(--gray-600);
    }

    @media (max-width: 1024px) {
        .contact-grid { grid-template-columns: 1fr 1.1fr; }
    }
    @media (max-width: 900px) {
        .contact-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 768px) {
        .contact-grid { grid-template-columns: 1fr; }
    }
</style>
