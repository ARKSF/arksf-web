---
// Latest Instagram posts. The site has no server, so the posts are fetched when the site is built,
// from a JSON feed (e.g. a Behold.so feed URL in src/data/site.json → "instagramFeed").
// No feed or the fetch fails → the section shows only the follow card, never an error.
// Preview builds (PUBLIC_PREVIEW=1) without a feed show labelled placeholder tiles.
import SectionHeader from '../SectionHeader.astro';
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import { home, site } from '../../lib/content';

type Post = { url: string; image: string; caption: string };
const LIMIT = 6;
let posts: Post[] = [];
if (site.instagramFeed) {
  try {
    const res = await fetch(site.instagramFeed);
    const data = await res.json();
    const list: any[] = Array.isArray(data) ? data : (data.posts ?? []);
    posts = list.slice(0, LIMIT).map((p) => ({
      url: p.permalink,
      image: p.sizes?.medium?.mediaUrl ?? p.thumbnailUrl ?? p.mediaUrl,
      caption: (p.prunedCaption ?? p.caption ?? '').toString(),
    })).filter((p) => p.url && p.image);
  } catch (e) {
    console.warn(`Instagram feed could not be loaded (${site.instagramFeed}): ${e}`);
  }
}
const placeholders = posts.length === 0 && import.meta.env.PUBLIC_PREVIEW === '1';
const { label, title, subtitle, handle, action } = home.instagram;
---
<section class="insta section" id="aktuality">
    <div class="container">
        <SectionHeader label={label} title={title} subtitle={subtitle} />
        {(posts.length > 0 || placeholders) && (
            <ul class="insta-grid">
                {posts.map((p) => (
                    <li><a href={p.url} target="_blank" rel="noopener" class="insta-tile" aria-label={p.caption ? `Instagram: ${p.caption.slice(0, 80)}` : 'Příspěvek na Instagramu'}>
                        <img src={p.image} alt="" loading="lazy" width="400" height="400" />
                        <span class="insta-tile-icon" aria-hidden="true"><Icon name="instagram" /></span>
                    </a></li>
                ))}
                {placeholders && Array.from({ length: LIMIT }, () => (
                    <li><div class="insta-tile insta-tile--sample"><Icon name="instagram" /><span>Příspěvek z IG</span></div></li>
                ))}
            </ul>
        )}
        <div class="insta-follow">
            <a href={site.instagram} target="_blank" rel="noopener" class="insta-handle"><Icon name="instagram" /> {handle}</a>
            <Button href={site.instagram} variant="primary" target="_blank" rel="noopener">{action} <Icon name="external-link" strokeWidth="2.5" /></Button>
        </div>
    </div>
</section>

<style>
    .insta { background: var(--color-surface); }
    .insta-grid {
        list-style: none;
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: var(--space-12);
        margin-bottom: var(--space-40);
    }
    .insta-tile {
        position: relative;
        display: block;
        aspect-ratio: 1 / 1;
        border-radius: var(--radius-md);
        overflow: hidden;
        background: var(--color-brand-subtle);
    }
    .insta-tile img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform var(--duration-slow) var(--ease-standard); }
    .insta-tile:hover img { transform: scale(1.06); }
    .insta-tile:focus-visible { outline: none; box-shadow: var(--focus-ring); }
    .insta-tile-icon {
        position: absolute;
        top: var(--space-8);
        right: var(--space-8);
        color: var(--color-text-inverse);
        opacity: 0;
        transition: opacity var(--duration-base) var(--ease-standard);
    }
    .insta-tile:hover .insta-tile-icon { opacity: 1; }
    .insta-tile-icon :global(svg) { width: 20px; height: 20px; }
    .insta-tile--sample {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: var(--space-8);
        color: var(--color-brand);
        font-size: var(--text-xs);
        font-weight: var(--fw-semibold);
        border: 2px dashed var(--color-brand-border);
    }
    .insta-tile--sample :global(svg) { width: 24px; height: 24px; opacity: 0.6; }
    .insta-follow {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: var(--space-16) var(--space-24);
    }
    .insta-handle {
        display: inline-flex;
        align-items: center;
        gap: var(--space-8);
        font-family: var(--font-heading);
        font-weight: var(--fw-semibold);
        font-size: var(--text-lg);
        color: var(--color-text);
    }
    .insta-handle :global(svg) { width: 22px; height: 22px; color: var(--color-accent); }
    .insta-handle:hover { color: var(--color-brand); }

    @media (max-width: 900px) {
        .insta-grid { grid-template-columns: repeat(3, 1fr); }
    }
</style>
