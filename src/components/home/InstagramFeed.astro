---
// Latest Instagram posts as news cards: photo, date and the start of the caption, linking to the post.
// The site has no server, so the posts are fetched when the site is built, from the Behold.so JSON feed
// in src/data/site.json → "instagramFeed"; the deploy workflow rebuilds daily so new posts appear.
// No feed or the fetch fails → the section shows only the follow link, never an error.
// Preview builds (PUBLIC_PREVIEW=1) without a feed show labelled placeholder cards.
import SectionHeader from '../SectionHeader.astro';
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import { home, site } from '../../lib/content';

type Post = { url: string; image: string; width: number; height: number; caption: string; date: string; video: boolean };
const LIMIT = 6;
let posts: Post[] = [];
if (site.instagramFeed) {
  try {
    const res = await fetch(site.instagramFeed);
    const data = await res.json();
    const list: any[] = Array.isArray(data) ? data : (data.posts ?? []);
    posts = list.slice(0, LIMIT).map((p) => {
      const size = p.sizes?.medium ?? p.sizes?.large ?? {};
      const when = p.timestamp ? new Date(p.timestamp) : undefined;
      return {
        url: p.permalink,
        image: size.mediaUrl ?? p.thumbnailUrl ?? p.mediaUrl,
        width: size.width ?? 525,
        height: size.height ?? 700,
        caption: (p.prunedCaption ?? p.caption ?? '').toString().trim(),
        date: when ? when.toLocaleDateString('cs-CZ', { day: 'numeric', month: 'long', year: 'numeric' }) : '',
        video: p.mediaType === 'VIDEO',
      };
    }).filter((p) => p.url && p.image);
  } catch (e) {
    console.warn(`Instagram feed could not be loaded (${site.instagramFeed}): ${e}`);
  }
}
const placeholders = posts.length === 0 && import.meta.env.PUBLIC_PREVIEW === '1';
const { label, title, subtitle, handle, action } = home.instagram;
---
<section class="insta section" id="aktuality">
    <div class="container">
        <SectionHeader label={label} title={title} subtitle={subtitle} />
        {(posts.length > 0 || placeholders) && (
            <ul class="insta-grid">
                {posts.map((p, i) => (
                    <li class={`reveal delay-${(i % 3) + 1}`}><a href={p.url} target="_blank" rel="noopener" class="insta-card">
                        <span class="insta-photo">
                            <img src={p.image} alt="" loading="lazy" decoding="async" width={p.width} height={p.height} />
                            {p.video && <span class="insta-badge">Video</span>}
                        </span>
                        <span class="insta-meta"><Icon name="instagram" /> {p.date}</span>
                        {p.caption && <span class="insta-caption">{p.caption}</span>}
                    </a></li>
                ))}
                {placeholders && Array.from({ length: LIMIT }, () => (
                    <li><div class="insta-card insta-card--sample"><span class="insta-photo"><Icon name="instagram" /></span><span class="insta-caption">Příspěvek z Instagramu</span></div></li>
                ))}
            </ul>
        )}
        <div class="insta-follow">
            <a href={site.instagram} target="_blank" rel="noopener" class="insta-handle"><Icon name="instagram" /> {handle}</a>
            <Button href={site.instagram} variant="secondary" target="_blank" rel="noopener">{action} <Icon name="external-link" strokeWidth="2.5" /></Button>
        </div>
    </div>
</section>

<style>
    .insta { background: var(--color-surface); }
    .insta-grid {
        list-style: none;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--space-40) var(--space-grid-gap);
        margin-bottom: var(--space-48);
    }
    .insta-card { display: flex; flex-direction: column; gap: var(--space-12); color: var(--color-text); }
    .insta-card:focus-visible { outline: none; }
    .insta-card:focus-visible .insta-photo { box-shadow: var(--focus-ring); }
    .insta-photo {
        position: relative;
        display: block;
        aspect-ratio: 3 / 4;
        overflow: hidden;
        border-radius: var(--radius-lg);
        background: var(--color-brand-subtle);
    }
    .insta-photo img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform var(--duration-reveal) var(--ease-standard); }
    .insta-card:hover .insta-photo img { transform: scale(1.04); }
    .insta-badge {
        position: absolute;
        top: var(--space-12);
        left: var(--space-12);
        padding: var(--space-4) var(--space-12);
        border-radius: var(--radius-pill);
        background: var(--color-surface-glass);
        font-size: var(--text-xs);
        font-weight: var(--fw-semibold);
    }
    .insta-meta { display: inline-flex; align-items: center; gap: var(--space-8); font-size: var(--text-sm); color: var(--color-text-muted); }
    .insta-meta :global(svg) { width: 16px; height: 16px; color: var(--color-accent); }
    .insta-caption {
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 3;
        overflow: hidden;
        line-height: var(--leading-normal);
        transition: color var(--duration-base) var(--ease-standard);
    }
    .insta-card:hover .insta-caption { color: var(--color-brand); }
    .insta-card--sample .insta-photo { display: flex; align-items: center; justify-content: center; color: var(--color-brand); border: 2px dashed var(--color-brand-border); }
    .insta-card--sample .insta-photo :global(svg) { width: 32px; height: 32px; opacity: 0.6; }
    .insta-follow { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: var(--space-16) var(--space-24); }
    .insta-handle { display: inline-flex; align-items: center; gap: var(--space-8); font-family: var(--font-heading); font-weight: var(--fw-semibold); font-size: var(--text-lg); color: var(--color-text); }
    .insta-handle :global(svg) { width: 22px; height: 22px; color: var(--color-accent); }
    .insta-handle:hover { color: var(--color-brand); }

    /* Tablet and phone: swipeable row */
    @media (max-width: 900px) {
        .insta-grid {
            display: flex;
            overflow-x: auto;
            scroll-snap-type: x mandatory;
            scrollbar-width: none;
            gap: var(--space-16);
            margin: 0 calc(var(--space-16) * -1) var(--space-40);
            padding: 0 var(--space-16);
            scroll-padding: 0 var(--space-16);
        }
        .insta-grid::-webkit-scrollbar { display: none; }
        .insta-grid > li { flex: 0 0 72%; scroll-snap-align: start; }
    }
</style>
