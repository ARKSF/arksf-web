---
// Home: the team at a glance. Each card links to that person's profile on the About page.
// People come from src/data/team.json, photos from src/assets/team/.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import SectionHeader from '../SectionHeader.astro';
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import { home, team } from '../../lib/content';

const photos = import.meta.glob<{ default: ImageMetadata }>('../../assets/team/*.{jpg,jpeg,png,webp}', { eager: true });
const photoOf = (file: string) => {
  const hit = photos[`../../assets/team/${file}`];
  if (!hit) throw new Error(`team.json: photo "${file}" not found in src/assets/team/`);
  return hit.default;
};
const people = team.map((p) => ({ ...p, img: photoOf(p.photo) }));
const CARD = { widths: [260, 360, 520, 780], sizes: '(max-width: 900px) 50vw, 260px' };
---
<section class="team section" id="tym">
    <div class="container">
        <SectionHeader label={home.team.label} title={home.team.title} subtitle={home.team.previewSubtitle} />
        <div class="team-grid">
            {people.map((p, i) => (
                <a href={`o-nas.html#${p.id}`} class={`team-card reveal delay-${i + 1}`}>
                    <Image src={p.img} alt={p.fullName} widths={CARD.widths} sizes={CARD.sizes} loading="lazy" />
                    <div class="team-card-overlay">
                        <h3 class="team-card-name">{p.name}</h3>
                        <p class="team-card-role">{p.role}</p>
                    </div>
                </a>
            ))}
        </div>
        <div class="team-more"><Button href="o-nas.html#tym" variant="secondary">{home.team.previewAction} <Icon name="arrow-right" strokeWidth="2.5" /></Button></div>
    </div>
</section>

<style>
    .team { background: var(--color-surface-alt); }
    .team-more { display: flex; justify-content: center; margin-top: var(--space-40); }
    .team-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: var(--space-20);
    }
    .team-card {
        display: block;
        position: relative;
        aspect-ratio: 3 / 4;
        border-radius: var(--radius-lg);
        overflow: hidden;
        cursor: pointer;
        background: var(--color-brand-subtle);
    }
    .team-card img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        display: block;
        transition: transform var(--duration-slow) var(--ease-standard);
    }
    .team-card:hover img { transform: scale(1.06); }
    .team-card-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, var(--color-scrim-90) 0%, var(--color-scrim-45) 40%, var(--color-scrim-0) 68%);
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: var(--space-20) var(--space-20) var(--space-16);
    }
    .team-card:focus-visible { outline: none; box-shadow: var(--focus-ring); }
    .team-card-name {
        color: var(--color-text-inverse);
        font-size: var(--text-base);
        margin-bottom: var(--space-4);
    }
    .team-card-role {
        color: var(--color-text-inverse-muted);
        font-size: var(--text-xs);
        line-height: var(--leading-normal);
        margin-bottom: 0;
    }


    @media (max-width: 900px) {
        .team-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 768px) {
        .team-grid { gap: var(--space-12); }
    }
</style>
