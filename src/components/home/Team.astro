---
// Team grid; a card opens that person's detail (photo, tags, bio). People come from src/data/team.json,
// photos from src/assets/team/ (file name in the "photo" field).
import type { ImageMetadata } from 'astro';
import SectionHeader from '../SectionHeader.astro';
import { home, team } from '../../lib/content';

const photos = import.meta.glob<{ default: ImageMetadata }>('../../assets/team/*.{jpg,jpeg,png,webp}', { eager: true });
const photoOf = (file: string) => {
  const hit = photos[`../../assets/team/${file}`];
  if (!hit) throw new Error(`team.json: photo "${file}" not found in src/assets/team/`);
  return hit.default;
};
const people = team.map((p) => ({ ...p, img: photoOf(p.photo) }));
const position = (p: { photoPosition?: string }) => (p.photoPosition ? `object-position: ${p.photoPosition};` : undefined);
---
<section class="team section" id="tym">
    <div class="container">
        <SectionHeader label={home.team.label} title={home.team.title} subtitle={home.team.subtitle} />

        <div class="team-grid">
            {people.map((p, i) => (
                <div class={`team-card reveal delay-${i + 1}`} data-member={p.id}>
                    <img src={p.img.src} alt={p.fullName} style={position(p)}>
                    <div class="team-card-overlay">
                        <h3 class="team-card-name">{p.name}</h3>
                        <p class="team-card-role">{p.role}</p>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>

<div class="team-modal-backdrop" id="teamModalBackdrop">
    {people.map((p) => (
        <div class="team-modal" data-member={p.id}>
            <button class="team-modal-close" aria-label="Zavřít">×</button>
            <div class="team-modal-photo"><img src={p.img.src} alt={p.fullName} style={position(p)}></div>
            <div class="team-modal-content">
                <h3 class="team-name">{p.fullName}</h3>
                <p class="team-role">{p.roleFull}</p>
                <div class="team-tags">
                    {p.tags.map((t) => <span class="team-tag">{t}</span>)}
                </div>
                <div class="team-bio">
                    {p.bio.map((para) => <p>{para}</p>)}
                </div>
            </div>
        </div>
    ))}
</div>

<script>
    const backdrop = document.getElementById('teamModalBackdrop');
    function openTeamModal(id) {
        document.querySelectorAll('.team-modal').forEach(m => {
            m.classList.toggle('active', m.dataset.member === id);
        });
        backdrop.classList.add('active');
        document.body.style.overflow = 'hidden';
    }
    function closeTeamModal() {
        backdrop.classList.remove('active');
        document.querySelectorAll('.team-modal').forEach(m => m.classList.remove('active'));
        document.body.style.overflow = '';
    }
    document.querySelectorAll('.team-card').forEach(card => {
        card.addEventListener('click', () => openTeamModal(card.dataset.member));
    });
    document.querySelectorAll('.team-modal-close').forEach(b => b.addEventListener('click', closeTeamModal));
    backdrop.addEventListener('click', (event) => { if (event.target === backdrop) closeTeamModal(); });
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeTeamModal();
    });
</script>

<style>
    .team { background: var(--white); }
    .team-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: var(--space-20);
    }
    .team-card {
        position: relative;
        aspect-ratio: 3 / 4;
        border-radius: var(--radius-16);
        overflow: hidden;
        cursor: pointer;
        background: var(--soft);
    }
    .team-card img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        display: block;
        transition: transform var(--duration-600) var(--ease-standard);
    }
    .team-card:hover img { transform: scale(1.06); }
    .team-card-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, var(--dark-a90) 0%, var(--dark-a45) 40%, var(--dark-a00) 68%);
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: var(--space-20) var(--space-20) var(--space-16);
    }
    .team-card-name {
        color: var(--white);
        font-size: var(--fs-16);
        margin-bottom: var(--space-2);
    }
    .team-card-role {
        color: var(--white-a75);
        font-size: var(--fs-12-5);
        line-height: var(--leading-1-4);
        margin-bottom: 0;
    }

    /* Detail */
    .team-modal-backdrop {
        position: fixed;
        inset: 0;
        background: var(--dark-a72);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        z-index: var(--z-modal);
        display: none;
        align-items: center;
        justify-content: center;
        padding: var(--space-24);
        opacity: 0;
        transition: opacity var(--duration-300) ease;
    }
    .team-modal-backdrop.active {
        display: flex;
        opacity: 1;
    }
    .team-modal {
        display: none;
        background: var(--white);
        border-radius: var(--radius-24);
        overflow: hidden;
        max-width: 940px;
        width: 100%;
        height: 520px;
        max-height: 85vh;
        grid-template-columns: 420px 1fr;
        position: relative;
        box-shadow: var(--shadow-modal);
    }
    .team-modal.active { display: grid; }
    .team-modal-close {
        position: absolute;
        top: 16px;
        right: 16px;
        width: 36px;
        height: 36px;
        border-radius: var(--radius-round);
        background: var(--white-a90);
        border: none;
        font-size: var(--fs-22);
        line-height: var(--leading-1);
        cursor: pointer;
        z-index: var(--z-raised);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--dark);
        transition: all var(--duration-200) ease;
    }
    .team-modal-close:hover { background: var(--white); transform: scale(1.08); }
    .team-modal-photo {
        position: relative;
        height: 100%;
    }
    .team-modal-photo img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        display: block;
    }
    .team-modal-content {
        height: 100%;
        padding: var(--space-40);
        overflow-y: auto;
    }
    .team-modal-content .team-name { font-size: var(--fs-22); margin-bottom: var(--space-4); }
    .team-modal-content .team-role {
        font-size: var(--fs-14);
        color: var(--primary);
        font-weight: var(--fw-semibold);
        margin-bottom: var(--space-20);
    }
    .team-tags {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-8);
        margin-bottom: var(--space-24);
    }
    .team-tag {
        font-size: var(--fs-12);
        background: var(--soft);
        color: var(--primary-dark);
        padding: var(--space-6) var(--space-12);
        border-radius: var(--radius-pill);
        font-weight: var(--fw-medium);
    }
    .team-bio p {
        color: var(--gray-600);
        font-size: var(--fs-14-5);
        line-height: var(--leading-1-7);
        margin-bottom: var(--space-14);
    }

    @media (max-width: 900px) {
        .team-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 768px) {
        .team-grid { grid-template-columns: repeat(2, 1fr); gap: var(--space-12); }
        .team-modal { grid-template-columns: 1fr; grid-template-rows: auto minmax(0, 1fr); height: 80vh; max-height: 80vh; }
        .team-modal-photo { width: 100%; height: auto; aspect-ratio: 4 / 5; max-height: 36vh; }
        .team-modal-photo img { object-position: center 20%; }
        .team-modal-content { height: 100%; min-height: 0; overflow-y: auto; -webkit-overflow-scrolling: touch; padding: var(--space-24) var(--space-20) var(--space-32); }
    }
</style>
