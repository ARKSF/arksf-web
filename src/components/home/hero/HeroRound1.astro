---
// Home page hero in six variants. The live site renders only the variant set in src/data/home.json
// ("hero.variant"). With PUBLIC_DESIGN_TOOLS=1 all six are rendered and a switcher (bottom left)
// flips between them, so they can be compared in a preview.
//   1 Ilustrace     light, diagonal violet band, the custom illustration
//   2 Fotka         full-bleed group photo with dark gradient
//   3 Split         dark text panel + full-height photo, illustration as a sticker
//   4 Tmavá         dark, violet glow, large illustration
//   5 Koláž         centred headline, three service photos below
//   6 Typografie    oversized headline with a photo capsule inside it
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Badge from '../../Badge.astro';
import Button from '../../Button.astro';
import Icon from '../../Icon.astro';
import HeroIllustration from '../HeroIllustration.astro';
import { home, site, photos, reviews, team } from '../../../lib/content';

const { hero } = home;
interface Props { offset: number; chosen: number; }
const { offset, chosen } = Astro.props;
const tools = import.meta.env.PUBLIC_DESIGN_TOOLS === '1';
const COUNT = 6;
const all_ = Array.from({ length: COUNT }, (_, i) => i + 1);
const variants = tools ? all_ : all_.filter((v) => offset + v === chosen);

const pics = import.meta.glob<{ default: ImageMetadata }>('../../../assets/photos/*.{jpg,jpeg,png,webp}', { eager: true });
const pic = (f: string) => pics[`../../../assets/photos/${f}`]?.default;
const rating = reviews.rating?.toLocaleString('cs-CZ', { minimumFractionDigits: 1 });
const services = [
  { href: 'spoluprace.html#konzultace', label: 'Fyzio 1:1', img: pic(photos.konzultace) },
  { href: 'spoluprace.html#treninky', label: 'Individuální tréninky', img: pic(photos.treninky) },
  { href: 'spoluprace.html#skupinove', label: 'Skupinové lekce', img: pic(photos.skupinove) },
];
---
{variants.map((v) => {
  const dark = v === 2 || v === 3 || v === 4;
  return (
<section class:list={['hero', `hero--v${v}`, dark && 'hero--dark']} data-hero={offset + v} hidden={tools && offset + v !== chosen ? true : undefined}>
    {v === 2 && pic(photos.skupinove) && <Image src={pic(photos.skupinove)!} alt="" class="hero-bg" widths={[960, 1440, 1920, 2400]} sizes="100vw" loading="eager" />}
    {v === 3 && pic(photos.hero) && <div class="hero-split-photo"><Image src={pic(photos.hero)!} alt="Trénink v ARK" widths={[640, 960, 1280]} sizes="(max-width: 900px) 100vw, 50vw" loading="eager" /><HeroIllustration class="hero-sticker" /></div>}
    <div class="container hero-inner">
        <div class="hero-content">
            <Badge tone={dark ? 'dark' : 'light'} dot class="hero-badge">{site.district}</Badge>
            <h1>
                {v === 6 ? (
                    <>{hero.titleBefore.split(' ').slice(0, -1).join(' ')}{' '}<span class="hero-capsule">{pic(photos.hero) && <Image src={pic(photos.hero)!} alt="" widths={[240, 480]} sizes="240px" loading="eager" />}</span>{' '}{hero.titleBefore.split(' ').slice(-1)}{' '}<span class="highlight">{hero.titleHighlight}</span>{' '}{hero.titleAfter}</>
                ) : (
                    <>{hero.titleBefore}{' '}<span class="highlight">{hero.titleHighlight}</span>{' '}{hero.titleAfter}</>
                )}
            </h1>
            <p class="hero-text">{hero.text}</p>
            <div class="hero-actions">
                <Button href={hero.cta.href} variant={dark ? 'accent' : 'primary'} size="lg">{hero.cta.label} <Icon name="arrow-right" strokeWidth="2.5" /></Button>
                <a href={hero.secondary.href} class="hero-secondary">{hero.secondary.text}{' '}<strong>{hero.secondary.label} →</strong></a>
            </div>
            <div class="hero-trust">
                {rating && <a href={reviews.googleUrl} target="_blank" rel="noopener" class="hero-rating"><Icon name="star" /> <strong>{rating}</strong> · {reviews.count} recenzí na Googlu</a>}
            </div>
        </div>
        {(v === 1 || v === 4) && <div class="hero-graphic"><HeroIllustration class="hero-illustration" /></div>}
        {v === 6 && <div class="hero-graphic hero-graphic--mark"><HeroIllustration class="hero-illustration" /></div>}
    </div>
    {v === 5 && (
        <div class="container hero-collage">
            {services.map((s, i) => s.img && (
                <a href={s.href} class={`hero-tile hero-tile--${i + 1}`}>
                    <Image src={s.img} alt="" widths={[360, 540, 720]} sizes="(max-width: 900px) 80vw, 360px" loading="eager" />
                    <span class="hero-tile-label">{s.label} <Icon name="arrow-right" strokeWidth="2.5" /></span>
                </a>
            ))}
            <HeroIllustration class="hero-collage-mark" />
        </div>
    )}
</section>
  );
})}



<style>
    /* ── Shared ── */
    .hero {
        position: relative;
        overflow: hidden;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: calc(var(--header-height) + var(--space-64)) 0 var(--space-80);
        background: var(--color-surface-alt);
    }
    .hero[hidden] { display: none; }
    .hero-inner { position: relative; z-index: var(--z-raised); display: grid; grid-template-columns: 1.1fr 1fr; gap: var(--space-64); align-items: center; }
    .hero-content { max-width: 600px; }
    .hero :global(.hero-badge) { margin-bottom: var(--space-24); }
    .hero h1 { font-size: var(--text-h1); line-height: var(--leading-tight); margin-bottom: var(--space-24); }
    .hero h1 .highlight {
        background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-accent) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    .hero-text { font-size: var(--text-lg); color: var(--color-text-muted); line-height: var(--leading-relaxed); max-width: 500px; margin-bottom: var(--space-32); }
    .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-16) var(--space-24); }
    .hero-secondary { font-size: var(--text-sm); color: var(--color-text-muted); }
    .hero-secondary strong { color: var(--color-brand); font-weight: var(--fw-semibold); }
    .hero-secondary:hover strong { text-decoration: underline; }
    .hero-trust { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-12) var(--space-16); margin-top: var(--space-40); }
    .hero-rating { display: inline-flex; align-items: center; gap: var(--space-4); font-size: var(--text-sm); color: var(--color-text-muted); }
    .hero-rating :global(svg) { width: 16px; height: 16px; color: var(--color-accent); fill: currentColor; }
    .hero-rating strong { color: var(--color-text); }
    .hero-rating:hover { color: var(--color-brand); }
    .hero-graphic { display: flex; justify-content: center; }
    .hero :global(.hero-illustration) {
        width: 100%;
        max-width: 400px;
        height: auto;
        filter: var(--shadow-illustration);
        animation: heroFloatR1 var(--duration-float) ease-in-out infinite;
    }
    @keyframes heroFloatR1 { 0%, 100% { transform: translateY(0) rotate(0deg); } 50% { transform: translateY(-15px) rotate(1deg); } }

    /* Dark variants */
    .hero--dark { background: var(--color-surface-inverse); color: var(--color-text-inverse); }
    .hero--dark .hero-text, .hero--dark .hero-secondary, .hero--dark .hero-rating { color: var(--color-text-inverse-muted); }
    .hero--dark .hero-secondary strong, .hero--dark .hero-rating strong { color: var(--color-text-inverse); }

    /* ── 1 Ilustrace ── */
    .hero--v1::before {
        content: '';
        position: absolute;
        top: -20%;
        right: -10%;
        width: 55%;
        height: 140%;
        background: linear-gradient(135deg, var(--color-brand-subtle) 0%, var(--color-brand-tint) 100%);
        transform: skewX(-12deg);
    }

    /* ── 2 Fotka ── */
    .hero--v2 :global(.hero-bg) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 35%; }
    .hero--v2::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(90deg, var(--color-scrim-90) 0%, var(--color-scrim-90) 30%, var(--color-scrim-45) 65%, var(--color-scrim-0) 100%);
    }
    .hero--v2 .hero-inner { grid-template-columns: 1fr; }

    /* ── 3 Split ── */
    .hero--v3 .hero-inner { grid-template-columns: 1fr 1fr; }
    .hero-split-photo { position: absolute; top: 0; right: 0; bottom: 0; width: 50%; }
    .hero-split-photo :global(img:not(.hero-sticker)) { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; display: block; }
    .hero-split-photo :global(.hero-sticker .ark-illustration-card) { display: none; }
    .hero-split-photo :global(.hero-sticker) {
        position: absolute;
        left: -80px;
        bottom: var(--space-64);
        width: 180px;
        height: auto;
        filter: var(--shadow-illustration-hover);
        animation: heroFloatR1 var(--duration-float) ease-in-out infinite;
    }

    /* ── 4 Tmavá ── */
    .hero--v4::before {
        content: '';
        position: absolute;
        top: -20%;
        right: -15%;
        width: 70%;
        height: 140%;
        background: radial-gradient(circle at 50% 50%, var(--color-brand-glow) 0%, transparent 60%);
    }
    .hero--v4 :global(.ark-illustration-card) { display: none; }
    .hero--v4 :global(.hero-illustration) { max-width: 520px; }

    /* ── 5 Koláž ── */
    .hero--v5 { justify-content: flex-start; }
    .hero--v5 .hero-inner { grid-template-columns: 1fr; justify-items: center; text-align: center; }
    .hero--v5 .hero-content { max-width: 760px; display: flex; flex-direction: column; align-items: center; }
    .hero--v5 .hero-text { margin-left: auto; margin-right: auto; }
    .hero--v5 .hero-actions, .hero--v5 .hero-trust { justify-content: center; }
    .hero-collage {
        position: relative;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--space-24);
        margin-top: var(--space-64);
        align-items: start;
    }
    .hero-tile { position: relative; display: block; border-radius: var(--radius-xl); overflow: hidden; aspect-ratio: 4 / 5; box-shadow: var(--shadow-lg); transition: transform var(--duration-base) var(--ease-standard); }
    .hero-tile--2 { margin-top: var(--space-48); }
    .hero-tile:hover { transform: translateY(-6px); }
    .hero-tile :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
    .hero-tile-label {
        position: absolute;
        left: var(--space-16);
        bottom: var(--space-16);
        display: inline-flex;
        align-items: center;
        gap: var(--space-8);
        background: var(--color-surface-glass);
        color: var(--color-text);
        font-family: var(--font-heading);
        font-weight: var(--fw-semibold);
        font-size: var(--text-sm);
        padding: var(--space-8) var(--space-16);
        border-radius: var(--radius-pill);
    }
    .hero-tile-label :global(svg) { width: 16px; height: 16px; color: var(--color-brand); }
    .hero-collage :global(.hero-collage-mark) { position: absolute; width: 140px; height: auto; right: calc(var(--space-24) * -1); top: calc(var(--space-48) * -1); filter: var(--shadow-illustration); }
    .hero-collage :global(.hero-collage-mark .ark-illustration-card) { display: none; }

    /* ── 6 Typografie ── */
    .hero--v6 .hero-inner { grid-template-columns: 1fr 220px; align-items: end; }
    .hero--v6 .hero-content { max-width: 960px; }
    .hero--v6 h1 { font-size: var(--text-display); line-height: var(--leading-none); letter-spacing: var(--tracking-tight); }
    .hero-capsule {
        display: inline-block;
        vertical-align: middle;
        width: 1.9em;
        height: 0.9em;
        border-radius: var(--radius-pill);
        overflow: hidden;
        margin: 0 0.05em; /* lint-allow: glyph-relative gap inside the headline */
        transform: translateY(-0.06em);
        box-shadow: var(--shadow-md);
    }
    .hero-capsule :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; display: block; }
    .hero--v6 .hero-graphic--mark :global(.hero-illustration) { max-width: 220px; }
    .hero--v6 :global(.ark-illustration-card) { display: none; }

    /* ── Responsive ── */
    @media (max-width: 900px) {
        .hero { min-height: auto; padding-top: calc(var(--header-height) + var(--space-48)); }
        .hero-inner, .hero--v3 .hero-inner, .hero--v6 .hero-inner { grid-template-columns: 1fr; gap: var(--space-40); }
        .hero--v1::before { display: none; }
        .hero--v1 .hero-graphic { display: none; }
        .hero--v4 .hero-graphic { order: -1; }
        .hero--v4 :global(.hero-illustration) { max-width: 240px; }
        .hero-split-photo { position: relative; width: 100%; height: 360px; order: 2; }
        .hero--v3 { padding-bottom: 0; }
        .hero--v3 .hero-inner { padding-bottom: var(--space-48); }
        .hero-split-photo :global(.hero-sticker .ark-illustration-card) { display: none; }
    .hero-split-photo :global(.hero-sticker) { left: auto; right: var(--space-16); bottom: var(--space-16); width: 120px; }
        .hero-collage { grid-template-columns: repeat(3, 70%); overflow-x: auto; scroll-snap-type: x mandatory; margin-top: var(--space-40); }
        .hero-tile { scroll-snap-align: start; }
        .hero-tile--2 { margin-top: 0; }
        .hero-collage :global(.hero-collage-mark) { display: none; }
        .hero--v6 .hero-graphic--mark { display: none; }
        .hero--v2::after { background: linear-gradient(180deg, var(--color-scrim-45) 0%, var(--color-scrim-90) 55%, var(--color-scrim-90) 100%); }
    }
</style>
