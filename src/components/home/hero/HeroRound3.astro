---
// Home page hero in three variants, all showing people and the team rather than one face.
// The live site renders only the variant in src/data/home.json ("hero.variant").
// With PUBLIC_DESIGN_TOOLS=1 all three are rendered with a switcher (bottom left) for comparison.
//   1 Bento     headline left, four photos in a bento grid right (group, coaching, physio, team)
//   2 Tým       the team photo full width, headline over it, three service cards on the lower edge
//   3 Panorama  centred headline, a wide group-training panorama with service links below
// Photos: src/data/photos.json → heroVariants.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Badge from '../../Badge.astro';
import Button from '../../Button.astro';
import Icon from '../../Icon.astro';
import { home, site, photos, reviews, team } from '../../../lib/content';

const { hero } = home;
interface Props { offset: number; chosen: number; }
const { offset, chosen } = Astro.props;
const tools = import.meta.env.PUBLIC_DESIGN_TOOLS === '1';
const COUNT = 3;
const all_ = Array.from({ length: COUNT }, (_, i) => i + 1);
const variants = tools ? all_ : all_.filter((v) => offset + v === chosen);

const all = import.meta.glob<{ default: ImageMetadata }>('../../../assets/photos/*.{jpg,jpeg,png,webp}', { eager: true });
const pic = (f: string) => {
  const hit = all[`../../../assets/photos/${f}`];
  if (!hit) throw new Error(`Hero photo "${f}" not found in src/assets/photos/`);
  return hit.default;
};
const hv = photos.heroVariants.r3;
const rating = reviews.rating?.toLocaleString('cs-CZ', { minimumFractionDigits: 1 });
const bentoAlt = ['Skupinová lekce v ARK', 'Trénink s fyzioterapeutem', 'Fyzioterapie 1:1', 'Tým ARK'];
const dark = (v: number) => v === 2;
---
{variants.map((v) => (
<section class:list={['hero', `hero--v${v}`, dark(v) && 'hero--dark']} data-hero={offset + v} hidden={tools && offset + v !== chosen ? true : undefined}>
    {v === 2 && <Image src={pic(hv.team)} alt="Tým ARK – Síla & Fyzio" class="h2-bg" widths={[960, 1440, 1920, 2400]} sizes="100vw" loading="eager" />}

    <div class="container hero-inner">
        <div class="hero-content">
            <Badge tone={dark(v) ? 'dark' : 'light'} dot class="hero-badge">{site.district}</Badge>
            <h1>{hero.titleBefore}{' '}<span class="highlight">{hero.titleHighlight}</span>{' '}{hero.titleAfter}</h1>
            <p class="hero-text">{hero.text}</p>
            <div class="hero-actions">
                <Button href={hero.cta.href} variant={dark(v) ? 'accent' : 'primary'} size="lg">{hero.cta.label} <Icon name="arrow-right" strokeWidth="2.5" /></Button>
                <a href={hero.secondary.href} class="hero-secondary">{hero.secondary.text}{' '}<strong>{hero.secondary.label} →</strong></a>
            </div>
            {v !== 2 && (
                <div class="hero-trust">
                    {rating && <a href={reviews.googleUrl} target="_blank" rel="noopener" class="hero-rating"><Icon name="star" /> <strong>{rating}</strong> · {reviews.count} recenzí na Googlu</a>}
                </div>
            )}
        </div>

        {v === 1 && (
            <div class="h1-bento">
                {hv.bento.map((f, i) => (
                    <div class={`h1-tile h1-tile--${i + 1}`}><Image src={pic(f)} alt={bentoAlt[i]} widths={[360, 540, 720, 960]} sizes={i === 0 ? '(max-width: 900px) 100vw, 560px' : '(max-width: 900px) 50vw, 280px'} loading="eager" /></div>
                ))}
                {rating && (
                    <a href={reviews.googleUrl} target="_blank" rel="noopener" class="h1-chip">
                        <strong>{rating}</strong>
                        <span><span class="h1-stars" aria-hidden="true">{Array.from({ length: 5 }, () => <Icon name="star" />)}</span>{reviews.count} recenzí na Googlu</span>
                    </a>
                )}
            </div>
        )}
    </div>

    {v === 3 && (
        <div class="container h3-panorama">
            <div class="h3-photo"><Image src={pic(hv.panorama)} alt="Skupinová lekce v ARK" widths={[960, 1440, 2200]} sizes="(max-width: 1140px) 100vw, 1092px" loading="eager" /></div>
        </div>
    )}

    {(v === 2 || v === 3) && (
        <div class="container hero-services-wrap">
            <ul class="hero-services">
                {hero.services.map((s) => (
                    <li><a href={s.href} class="hero-service">
                        <span><strong>{s.label}</strong><small>{s.text}</small></span>
                        <span class="hero-service-arrow" aria-hidden="true"><Icon name="arrow-right" strokeWidth="2.5" /></span>
                    </a></li>
                ))}
            </ul>
        </div>
    )}
</section>
))}



<style>
    /* ── Shared ── */
    .hero {
        position: relative;
        overflow: hidden;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: calc(var(--header-height) + var(--space-48)) 0 var(--space-64);
        background: var(--color-surface-alt);
    }
    .hero[hidden] { display: none; }
    .hero > .container { width: 100%; }
    .hero-inner { position: relative; z-index: var(--z-raised); display: grid; grid-template-columns: 1fr 1.1fr; gap: var(--space-64); align-items: center; }
    .hero :global(.hero-badge) { margin-bottom: var(--space-24); }
    .hero h1 { font-size: var(--text-h1); line-height: var(--leading-tight); letter-spacing: var(--tracking-tight); margin-bottom: var(--space-24); }
    .hero h1 .highlight {
        background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-accent) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    .hero-text { font-size: var(--text-lg); color: var(--color-text-muted); line-height: var(--leading-relaxed); max-width: 500px; margin-bottom: var(--space-32); }
    .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-16) var(--space-24); }
    .hero-secondary { font-size: var(--text-sm); color: var(--color-text-muted); }
    .hero-secondary strong { color: var(--color-brand); font-weight: var(--fw-semibold); }
    .hero-secondary:hover strong { text-decoration: underline; }
    .hero-trust { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-12) var(--space-16); margin-top: var(--space-40); }
    .hero-rating { display: inline-flex; align-items: center; gap: var(--space-4); font-size: var(--text-sm); color: var(--color-text-muted); }
    .hero-rating :global(svg) { width: 16px; height: 16px; color: var(--color-accent); fill: currentColor; }
    .hero-rating strong { color: var(--color-text); }
    .hero-rating:hover { color: var(--color-brand); }

    .hero--dark { background: var(--color-surface-inverse); color: var(--color-text-inverse); }
    .hero--dark .hero-text, .hero--dark .hero-secondary { color: var(--color-text-inverse-muted); }
    .hero--dark .hero-secondary strong { color: var(--color-text-inverse); }

    /* Service shortcuts (variants 2 and 3) */
    .hero-services-wrap { position: relative; z-index: var(--z-raised); }
    .hero-services { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-16); }
    .hero-service {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-16);
        height: 100%;
        padding: var(--space-20) var(--space-24);
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-md);
        color: var(--color-text);
        transition: all var(--duration-base) var(--ease-standard);
    }
    .hero-service:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); border-color: var(--color-brand); }
    .hero-service:focus-visible { outline: none; box-shadow: var(--focus-ring); }
    .hero-service strong { display: block; font-family: var(--font-heading); font-size: var(--text-base); margin-bottom: var(--space-4); }
    .hero-service small { display: block; font-size: var(--text-sm); color: var(--color-text-muted); }
    .hero-service-arrow {
        flex-shrink: 0;
        width: 40px; height: 40px;
        display: flex; align-items: center; justify-content: center;
        border-radius: var(--radius-round);
        background: var(--color-brand-subtle);
        color: var(--color-brand);
        transition: all var(--duration-base) var(--ease-standard);
    }
    .hero-service-arrow :global(svg) { width: 18px; height: 18px; }
    .hero-service:hover .hero-service-arrow { background: var(--color-brand); color: var(--color-text-inverse); }

    /* ── 1 Bento ── */
    .h1-bento {
        position: relative;
        display: grid;
        grid-template-rows: 1fr 1fr;
        gap: var(--space-12);
        height: min(620px, 72vh);
    }
    .h1-tile { border-radius: var(--radius-lg); overflow: hidden; background: var(--color-brand-subtle); }
    .h1-tile :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
    .h1-tile--1 { grid-row: 1 / span 2; }
    .h1-tile--1 :global(img) { object-position: 40% center; }
    .h1-tile--2 :global(img) { object-position: center 30%; }
    .h1-bento { grid-template-columns: 1.15fr 0.85fr 0.85fr; }
    .h1-tile--1 { grid-column: 1; grid-row: 1 / span 2; }
    .h1-tile--2 { grid-column: 2; grid-row: 1; }
    .h1-tile--3 { grid-column: 3; grid-row: 1; }
    .h1-tile--4 { grid-column: 2 / span 2; grid-row: 2; }
    .h1-chip {
        position: absolute;
        left: calc(var(--space-24) * -1);
        bottom: var(--space-32);
        display: flex;
        align-items: center;
        gap: var(--space-12);
        padding: var(--space-12) var(--space-20);
        background: var(--color-surface);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-lg);
        font-size: var(--text-xs);
        color: var(--color-text-muted);
    }
    .h1-chip > strong { font-family: var(--font-heading); font-size: var(--text-3xl); line-height: var(--leading-none); color: var(--color-text); }
    .h1-chip > span { display: flex; flex-direction: column; gap: var(--space-4); }
    .h1-stars { display: flex; gap: var(--space-4); color: var(--color-accent); }
    .h1-stars :global(svg) { width: 14px; height: 14px; fill: currentColor; }

    /* ── 2 Tým ── */
    .hero--v2 { justify-content: flex-end; padding-bottom: var(--space-48); }
    .hero--v2 :global(.h2-bg) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 35%; }
    .hero--v2::after {
        content: '';
        position: absolute;
        inset: 0;
        background:
            linear-gradient(90deg, var(--color-scrim-90) 0%, var(--color-scrim-90) 25%, var(--color-scrim-45) 50%, var(--color-scrim-0) 70%),
            linear-gradient(0deg, var(--color-scrim-90) 0%, var(--color-scrim-0) 40%);
    }
    .hero--v2 .hero-inner { grid-template-columns: 1fr; }
    .hero--v2 .hero-content { max-width: 560px; margin-bottom: var(--space-48); }

    /* ── 3 Panorama ── */
    .hero--v3 { justify-content: flex-start; }
    .hero--v3 .hero-inner { grid-template-columns: 1fr; }
    .hero--v3 .hero-content { max-width: 780px; margin: 0 auto; text-align: center; display: flex; flex-direction: column; align-items: center; }
    .hero--v3 .hero-text { margin-left: auto; margin-right: auto; }
    .hero--v3 .hero-actions, .hero--v3 .hero-trust { justify-content: center; }
    .hero--v3 .hero-trust { margin-top: var(--space-24); }
    .h3-panorama { margin-top: var(--space-40); }
    .h3-photo { border-radius: var(--radius-xl); overflow: hidden; aspect-ratio: 21 / 7; box-shadow: var(--shadow-lg); }
    .h3-photo :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: center 45%; display: block; }
    .hero--v3 .hero-services-wrap { margin-top: calc(var(--space-48) * -1); padding: 0 var(--space-48); }

    /* ── Responsive ── */
    @media (max-width: 1024px) {
        .hero-services { grid-template-columns: 1fr; }
        .hero--v3 .hero-services-wrap { padding: 0 var(--space-24); }
    }
    @media (max-width: 900px) {
        .hero { min-height: auto; padding-top: calc(var(--header-height) + var(--space-40)); padding-bottom: var(--space-48); }
        .hero-inner { grid-template-columns: 1fr; gap: var(--space-40); }
        .h1-bento { height: 420px; grid-template-columns: 1.2fr 1fr; grid-template-rows: 1fr 1fr; }
        .h1-tile--1 { grid-column: 1; grid-row: 1 / span 2; }
        .h1-tile--2 { grid-column: 2; grid-row: 1; }
        .h1-tile--3 { display: none; }
        .h1-tile--4 { grid-column: 2; grid-row: 2; }
        .h1-chip { left: var(--space-12); bottom: var(--space-12); }
        .hero--v2 { min-height: 92vh; }
        .hero--v2 :global(.h2-bg) { object-position: 60% center; }
        .hero--v2::after { background: linear-gradient(0deg, var(--color-scrim-90) 0%, var(--color-scrim-90) 55%, var(--color-scrim-45) 80%, var(--color-scrim-45) 100%); }
        .hero--v2 .hero-content { margin-bottom: var(--space-32); }
        .h3-photo { aspect-ratio: 4 / 3; }
        .hero--v3 .hero-services-wrap { margin-top: var(--space-16); padding: 0; }
    }
</style>
