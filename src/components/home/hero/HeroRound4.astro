---
// Round 4 (16–19): variants built on the "//" mark from the section labels.
//   16 Lomítka   two slanted // windows with photos (group lesson, physio)
//   17 Pruhy     dark, // stripes in the brand gradient, photo cut on the same slant
//   18 Typo //   a giant gradient // glyph, services listed as // labels, slanted photo strip
//   19 Řez       the page split by a double // band: text left, team photo right
// The slant matches the // glyph of Space Grotesk (about 20° from vertical).
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Badge from '../../Badge.astro';
import Button from '../../Button.astro';
import Icon from '../../Icon.astro';
import { home, site, photos, reviews } from '../../../lib/content';

interface Props { offset: number; chosen: number; }
const { offset, chosen } = Astro.props;
const tools = import.meta.env.PUBLIC_DESIGN_TOOLS === '1';
const COUNT = 4;
const all_ = Array.from({ length: COUNT }, (_, i) => i + 1);
const variants = tools ? all_ : all_.filter((v) => offset + v === chosen);

const pics = import.meta.glob<{ default: ImageMetadata }>('../../../assets/photos/*.{jpg,jpeg,png,webp}', { eager: true });
const pic = (f: string) => {
  const hit = pics[`../../../assets/photos/${f}`];
  if (!hit) throw new Error(`Hero photo "${f}" not found in src/assets/photos/`);
  return hit.default;
};
const hv = photos.heroVariants.r4;
const { hero } = home;
const rating = reviews.rating?.toLocaleString('cs-CZ', { minimumFractionDigits: 1 });
const dark = (v: number) => v === 2;
---
{variants.map((v) => (
<section class:list={['hero', `hero--v${v}`, dark(v) && 'hero--dark']} data-hero={offset + v} hidden={tools && offset + v !== chosen ? true : undefined}>
    {v === 2 && <div class="h17-stripes" aria-hidden="true">{Array.from({ length: 7 }, () => <i></i>)}</div>}
    {v === 3 && <span class="h18-glyph" aria-hidden="true">//</span>}
    {v === 4 && (
        <div class="h19-photo">
            <Image src={pic(hv.split)} alt="Tým ARK – Síla & Fyzio" widths={[720, 1080, 1440]} sizes="(max-width: 900px) 100vw, 60vw" loading="eager" />
        </div>
    )}

    <div class="container hero-inner">
        <div class="hero-content">
            <span class="section-label hero-kicker">// {site.district}</span>
            <h1>{hero.titleBefore}{' '}<span class="highlight">{hero.titleHighlight}</span>{' '}{hero.titleAfter}</h1>
            <p class="hero-text">{hero.text}</p>
            <div class="hero-actions">
                <Button href={hero.cta.href} variant={dark(v) ? 'accent' : 'primary'} size="lg">{hero.cta.label} <Icon name="arrow-right" strokeWidth="2.5" /></Button>
                <a href={hero.secondary.href} class="hero-secondary">{hero.secondary.text}{' '}<strong>{hero.secondary.label} →</strong></a>
            </div>
            {v === 3 ? (
                <ul class="h18-services">
                    {hero.services.map((s) => <li><a href={s.href}><span>//</span>{" "}{s.label}</a></li>)}
                </ul>
            ) : (
                rating && <a href={reviews.googleUrl} target="_blank" rel="noopener" class="hero-rating"><span class="hero-rating-slash">//</span> <Icon name="star" /> <strong>{rating}</strong> · {reviews.count} recenzí na Googlu</a>
            )}
        </div>

        {v === 1 && (
            <div class="h16-slashes">
                {hv.slashes.map((f, i) => (
                    <div class={`h16-slash h16-slash--${i + 1}`}><Image src={pic(f)} alt="" widths={[480, 720, 960]} sizes="(max-width: 900px) 50vw, 320px" loading="eager" /></div>
                ))}
            </div>
        )}
        {v === 2 && (
            <div class="h17-photo"><Image src={pic(hv.stripes)} alt="Trénink s fyzioterapeutem" widths={[480, 720, 960]} sizes="(max-width: 900px) 100vw, 480px" loading="eager" /></div>
        )}
        {v === 3 && (
            <div class="h18-strip">
                {hv.typo.map((f) => <div class="h18-cut"><Image src={pic(f)} alt="" widths={[320, 480, 640]} sizes="(max-width: 900px) 33vw, 200px" loading="eager" /></div>)}
            </div>
        )}
    </div>
</section>
))}

<style>
    /* ── Shared ── */
    .hero {
        position: relative;
        overflow: hidden;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: calc(var(--header-height) + var(--space-48)) 0 var(--space-64);
        background: var(--color-surface-alt);
    }
    .hero[hidden] { display: none; }
    .hero > .container { width: 100%; }
    .hero-inner { position: relative; z-index: var(--z-raised); display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-64); align-items: center; }
    .hero-kicker { margin-bottom: var(--space-24); }
    .hero h1 { font-size: var(--text-h1); line-height: var(--leading-tight); letter-spacing: var(--tracking-tight); margin-bottom: var(--space-24); }
    .hero h1 .highlight {
        background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-accent) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    .hero-text { font-size: var(--text-lg); color: var(--color-text-muted); line-height: var(--leading-relaxed); max-width: 500px; margin-bottom: var(--space-32); }
    .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-16) var(--space-24); }
    .hero-secondary { font-size: var(--text-sm); color: var(--color-text-muted); }
    .hero-secondary strong { color: var(--color-brand); font-weight: var(--fw-semibold); }
    .hero-secondary:hover strong { text-decoration: underline; }
    .hero-rating { display: inline-flex; align-items: center; gap: var(--space-4); margin-top: var(--space-40); font-size: var(--text-sm); color: var(--color-text-muted); }
    .hero-rating :global(svg) { width: 16px; height: 16px; color: var(--color-accent); fill: currentColor; }
    .hero-rating strong { color: var(--color-text); }
    .hero-rating-slash { font-family: var(--font-heading); font-weight: var(--fw-bold); color: var(--color-brand); margin-right: var(--space-4); }
    .hero-rating:hover { color: var(--color-brand); }

    .hero--dark { background: var(--color-surface-inverse); color: var(--color-text-inverse); }
    .hero--dark .hero-kicker { color: var(--color-accent); }
    .hero--dark .hero-text, .hero--dark .hero-secondary, .hero--dark .hero-rating { color: var(--color-text-inverse-muted); }
    .hero--dark .hero-secondary strong, .hero--dark .hero-rating strong { color: var(--color-text-inverse); }
    .hero--dark .hero-rating-slash { color: var(--color-accent); }

    /* ── 16 Lomítka ── */
    .h16-slashes { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 0; height: min(600px, 72vh); }
    .h16-slash { position: relative; overflow: hidden; clip-path: polygon(38% 0, 100% 0, 62% 100%, 0 100%); }
    .h16-slash--1 { margin-right: -18%; }
    .h16-slash--2 { margin-left: -18%; transform: translateY(var(--space-48)); }
    .h16-slash :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
    .h16-slash--1 :global(img) { object-position: 45% center; }
    .h16-slash--2 :global(img) { object-position: 40% center; }
    .hero--v1::before {
        content: '';
        position: absolute;
        right: 6%;
        top: 14%;
        width: 120px;
        height: 72%;
        background: linear-gradient(180deg, var(--color-brand), var(--color-accent));
        clip-path: polygon(70% 0, 100% 0, 30% 100%, 0 100%);
        opacity: 0.9;
    }

    /* ── 17 Pruhy ── */
    .h17-stripes { position: absolute; inset: -10% -20% -10% 35%; display: flex; gap: var(--space-40); transform: skewX(-20deg); pointer-events: none; }
    .h17-stripes i { flex: 0 0 56px; background: linear-gradient(180deg, var(--color-brand) 0%, var(--color-accent) 100%); opacity: 0.16; }
    .h17-stripes i:nth-child(2n) { flex-basis: 24px; opacity: 0.28; }
    .h17-photo {
        justify-self: end;
        width: 100%;
        max-width: 480px;
        aspect-ratio: 4 / 5;
        clip-path: polygon(22% 0, 100% 0, 78% 100%, 0 100%);
        overflow: hidden;
    }
    .h17-photo :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }

    /* ── 18 Typo // ── */
    .h18-glyph {
        position: absolute;
        left: -4%;
        top: 50%;
        transform: translateY(-55%);
        font-family: var(--font-heading);
        font-weight: var(--fw-bold);
        font-size: min(70vw, 900px); /* lint-allow: decorative glyph sized to the viewport */
        line-height: var(--leading-none);
        letter-spacing: var(--tracking-tight);
        background: linear-gradient(135deg, var(--color-brand-subtle) 0%, var(--color-brand-tint) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        pointer-events: none;
    }
    .h18-services { list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-8) var(--space-24); margin-top: var(--space-40); padding-top: var(--space-24); border-top: 1px solid var(--color-border); }
    .h18-services a { font-family: var(--font-heading); font-weight: var(--fw-semibold); color: var(--color-text); }
    .h18-services a span { color: var(--color-brand); }
    .h18-services a:hover { color: var(--color-brand); }
    .h18-strip { display: grid; grid-template-columns: repeat(3, 1fr); height: min(560px, 68vh); }
    .h18-cut { overflow: hidden; clip-path: polygon(30% 0, 100% 0, 70% 100%, 0 100%); margin: 0 -14%; }
    .h18-cut:nth-child(2) { transform: translateY(var(--space-40)); }
    .h18-cut :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }

    /* ── 19 Řez ── */
    .hero--v4 .hero-inner { grid-template-columns: 1fr 1fr; }
    .hero--v4 .hero-content { max-width: 500px; }
    .h19-photo { position: absolute; top: 0; right: 0; bottom: 0; width: 56%; clip-path: polygon(22% 0, 100% 0, 100% 100%, 0 100%); }
    .h19-photo :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 60% center; display: block; }
    .h19-photo::before {
        content: '';
        position: absolute;
        top: 0; bottom: 0; left: 0;
        width: 26%;
        z-index: var(--z-raised);
        background: linear-gradient(180deg, var(--color-brand), var(--color-accent));
        clip-path: polygon(84% 0, 100% 0, 16% 100%, 0 100%);
    }
    .h19-photo::after {
        content: '';
        position: absolute;
        top: 0; bottom: 0; left: 6%;
        width: 26%;
        z-index: var(--z-raised);
        background: linear-gradient(180deg, var(--color-accent), var(--color-brand));
        clip-path: polygon(92% 0, 100% 0, 8% 100%, 0 100%);
    }

    /* ── Responsive ── */
    @media (max-width: 900px) {
        .hero { min-height: auto; padding-top: calc(var(--header-height) + var(--space-40)); padding-bottom: var(--space-48); }
        .hero-inner, .hero--v4 .hero-inner { grid-template-columns: 1fr; gap: var(--space-40); }
        .h16-slashes { height: 360px; }
        .hero--v1::before { display: none; }
        .h17-stripes { inset: -10% -40% -10% 10%; }
        .h17-photo { justify-self: center; max-width: 340px; }
        .h18-strip { height: 300px; }
        .h18-glyph { left: -20%; }
        .h19-photo { position: relative; width: 100%; height: 300px; order: 2; clip-path: polygon(0 8%, 100% 0, 100% 100%, 0 100%); margin-top: var(--space-32); }
        .hero--v4 { padding-bottom: 0; }
        .h19-photo::before, .h19-photo::after { display: none; }
    }
</style>
