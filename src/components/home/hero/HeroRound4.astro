---
// Round 4 (16, the live hero): two slanted // windows built on the "//" mark from the section labels.
// Each window has a coloured backing slash, rotates through a few photos (crossfade), and the whole
// hero animates in on page load. With prefers-reduced-motion there is no animation and no rotation.
// The slant matches the // glyph of Space Grotesk (about 20° from vertical).
// Photos and their focus points (the person's x position, %) are in photos.json → heroVariants.r4.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Button from '../../Button.astro';
import Icon from '../../Icon.astro';
import { home, site, photos } from '../../../lib/content';

interface Props { offset: number; chosen: number; }
const { offset, chosen } = Astro.props;
const tools = import.meta.env.PUBLIC_DESIGN_TOOLS === '1';
const COUNT = 1;
const all_ = Array.from({ length: COUNT }, (_, i) => i + 1);
const variants = tools ? all_ : all_.filter((v) => offset + v === chosen);

const pics = import.meta.glob<{ default: ImageMetadata }>('../../../assets/photos/*.{jpg,jpeg,png,webp}', { eager: true });
const pic = (f: string) => {
  const hit = pics[`../../../assets/photos/${f}`];
  if (!hit) throw new Error(`Hero photo "${f}" not found in src/assets/photos/`);
  return hit.default;
};
const hv = photos.heroVariants.r4;
const { hero } = home;
const dark = (_v: number) => false;
// The slashes are tall and narrow, so a photo is drawn much wider than its slot (object-fit: cover).
// `sizes` states that drawn width, so the browser picks a file sharp enough for retina screens.
const SLASH_SIZES = ['(max-width: 900px) 60vw, 480px', '(max-width: 900px) 120vw, 960px'];
---
{variants.map((v) => (
<section class:list={['hero', `hero--v${v}`, dark(v) && 'hero--dark']} data-hero={offset + v} hidden={tools && offset + v !== chosen ? true : undefined}>

    <div class="container hero-inner">
        <div class="hero-content">
            <span class="section-label hero-kicker">// {site.district}</span>
            <h1>{hero.titleBefore}{' '}<span class="highlight">{hero.titleHighlight}</span>{' '}{hero.titleAfter}</h1>
            <p class="hero-text">{hero.text}</p>
            <div class="hero-actions">
                <Button href={hero.cta.href} variant={dark(v) ? 'accent' : 'primary'} size="lg">{hero.cta.label} <Icon name="arrow-right" strokeWidth="2.5" /></Button>
                <a href={hero.secondary.href} class="hero-secondary">{hero.secondary.text}{' '}<strong>{hero.secondary.label} →</strong></a>
            </div>
        </div>

        {v === 1 && (
            <div class="h16-slashes" data-slash-rotate>
                {hv.slashes.map((set, i) => (
                    <div class={`h16-slash h16-slash--${i + 1}`}>
                        <span class="h16-back" aria-hidden="true"></span>
                        <div class="h16-frame">
                            {set.map((ph, k) => (
                                <Image src={pic(ph.file)} alt={ph.alt} class:list={['h16-photo', k === 0 && 'is-on']} style={`--focus: ${ph.focus}%;`}
                                    widths={[640, 960, 1280, 1600, 2000]} sizes={SLASH_SIZES[i]} quality={88} loading={k === 0 ? 'eager' : 'lazy'} />
                            ))}
                        </div>
                    </div>
                ))}
            </div>
        )}
    </div>
</section>
))}

<script>
    // Crossfade through each slash's photos; the second slash runs half a beat later.
    const box = document.querySelector('[data-slash-rotate]');
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (box && !still) {
        const slashes = [...box.querySelectorAll('.h16-frame')];
        const step = (frame) => {
            const imgs = [...frame.querySelectorAll('.h16-photo')];
            if (imgs.length < 2) return;
            const i = imgs.findIndex((img) => img.classList.contains('is-on'));
            const next = imgs[(i + 1) % imgs.length];
            next.loading = 'eager';
            imgs[i].classList.remove('is-on');
            next.classList.add('is-on');
        };
        // load the next photos early, after the page is idle
        setTimeout(() => box.querySelectorAll('.h16-photo').forEach((img) => { img.loading = 'eager'; }), 2500);
        const INTERVAL = 4800;
        slashes.forEach((frame, n) => {
            setTimeout(() => setInterval(() => { if (!document.hidden) step(frame); }, INTERVAL), 1800 + n * (INTERVAL / 2));
        });
    }
</script>

<style>
    /* ── Shared ── */
    .hero {
        position: relative;
        overflow: hidden;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: calc(var(--header-height) + var(--space-48)) 0 var(--space-64);
        background: var(--color-surface-alt);
    }
    .hero[hidden] { display: none; }
    .hero > .container { width: 100%; }
    .hero-inner { position: relative; z-index: var(--z-raised); display: grid; grid-template-columns: 1fr 1.15fr; gap: var(--space-64); align-items: center; }
    .hero-kicker { margin-bottom: var(--space-24); }
    .hero h1 { font-size: var(--text-h1); line-height: var(--leading-tight); letter-spacing: var(--tracking-tight); margin-bottom: var(--space-24); }
    .hero h1 .highlight {
        background: linear-gradient(135deg, var(--color-brand) 0%, var(--color-accent) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    .hero-text { font-size: var(--text-lg); color: var(--color-text-muted); line-height: var(--leading-relaxed); max-width: 500px; margin-bottom: var(--space-32); }
    .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-16) var(--space-24); }
    .hero-secondary { font-size: var(--text-sm); color: var(--color-text-muted); }
    .hero-secondary strong { color: var(--color-brand); font-weight: var(--fw-semibold); }
    .hero-secondary:hover strong { text-decoration: underline; }

    .hero--dark { background: var(--color-surface-inverse); color: var(--color-text-inverse); }
    .hero--dark .hero-kicker { color: var(--color-accent); }
    .hero--dark .hero-text, .hero--dark .hero-secondary { color: var(--color-text-inverse-muted); }
    .hero--dark .hero-secondary strong { color: var(--color-text-inverse); }

    /* ── 16 Lomítka ── */
    .hero--v1::before {
        /* soft violet wash behind the slashes */
        content: '';
        position: absolute;
        top: 0;
        right: 0;
        width: 55%;
        height: 100%;
        background: radial-gradient(ellipse at 60% 45%, var(--color-brand-tint) 0%, transparent 65%);
        pointer-events: none;
    }
    .h16-slashes { position: relative; display: grid; grid-template-columns: 1fr 1fr; height: min(600px, 72vh); }
    .h16-slash { position: relative; }
    .h16-slash--1 { margin-right: -13%; }
    .h16-slash--2 { margin-left: -13%; transform: translateY(var(--space-48)); }
    .h16-frame, .h16-back { position: absolute; inset: 0; clip-path: polygon(28% 0, 100% 0, 72% 100%, 0 100%); }
    .h16-frame { overflow: hidden; }
    .h16-back { transform: translate(var(--space-20), var(--space-20)); }
    .h16-slash--1 .h16-back { background: var(--color-brand-subtle); }
    .h16-slash--2 .h16-back { background: var(--color-accent-subtle); }
    .h16-frame :global(.h16-photo) {
        /* The person's x position in the photo (--focus) lands on the middle of the slash, at any size:
           translateX(%) is relative to the image's own width. */
        position: absolute;
        top: 0;
        left: 50%;
        height: 100%;
        width: auto;
        min-width: 100%;
        max-width: none;
        object-fit: cover;
        transform: translateX(calc(var(--focus) * -1)); /* lint-allow: --focus is set per photo */
        display: block;
        opacity: 0;
        transition: opacity var(--duration-reveal) var(--ease-standard);
    }
    .h16-frame :global(.h16-photo.is-on) { opacity: 1; }

    /* Load animation */
    @keyframes h16Up { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }
    @keyframes h16Wipe { from { clip-path: polygon(28% 100%, 100% 100%, 72% 100%, 0 100%); } to { clip-path: polygon(28% 0, 100% 0, 72% 100%, 0 100%); } }
    @keyframes h16Back { from { opacity: 0; transform: translate(0, 0); } to { opacity: 1; transform: translate(var(--space-20), var(--space-20)); } }
    @media (prefers-reduced-motion: no-preference) {
        .hero--v1 .hero-content > * { animation: h16Up var(--duration-reveal) var(--ease-standard) both; }
        .hero--v1 .hero-content > :nth-child(1) { animation-delay: calc(var(--duration-stagger) * 1); }
        .hero--v1 .hero-content > :nth-child(2) { animation-delay: calc(var(--duration-stagger) * 2); }
        .hero--v1 .hero-content > :nth-child(3) { animation-delay: calc(var(--duration-stagger) * 3); }
        .hero--v1 .hero-content > :nth-child(4) { animation-delay: calc(var(--duration-stagger) * 4); }
        .h16-frame { animation: h16Wipe 1.1s var(--ease-standard) both; } /* lint-allow: one-off entrance */
        .h16-slash--1 .h16-frame { animation-delay: calc(var(--duration-stagger) * 2); }
        .h16-slash--2 .h16-frame { animation-delay: calc(var(--duration-stagger) * 5); }
        .h16-back { animation: h16Back var(--duration-reveal) var(--ease-standard) both; }
        .h16-slash--1 .h16-back { animation-delay: calc(var(--duration-stagger) * 9); }
        .h16-slash--2 .h16-back { animation-delay: calc(var(--duration-stagger) * 12); }
    }

    /* ── Responsive ── */
    @media (max-width: 900px) {
        .hero { min-height: auto; padding-top: calc(var(--header-height) + var(--space-40)); padding-bottom: var(--space-48); }
        .hero-inner { grid-template-columns: 1fr; gap: var(--space-40); }
        .h16-slashes { height: 360px; }
    </style>
