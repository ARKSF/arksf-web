---
// Message form. Sends to Formspree (address in src/data/site.json) without leaving the page,
// then replaces the form with a thank-you note. Above it: a shortcut to online booking.
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import { home, site } from '../../lib/content';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const { contact } = home;
const f = contact.form;
---
<div class:list={['contact-form', className]}>
    <div class="booking-banner">
        <span class="booking-banner-text">{contact.bookingBanner.text}</span>
        <Button href={contact.bookingBanner.href} variant="primary" size="sm">{contact.bookingBanner.action} <Icon name="arrow-right" strokeWidth="2.5" /></Button>
    </div>
    <h3>{contact.formTitle}</h3>
    <form id="contactForm" action={site.formspree} method="POST" data-sending={f.sending} data-success-title={f.successTitle} data-success-text={f.successText} data-error={`${f.error} ${site.email}`}>
        <div class="form-row">
            <div class="form-group">
                <label for="name">{f.name.label}</label>
                <input type="text" id="name" name="name" required placeholder={f.name.placeholder}>
            </div>
            <div class="form-group">
                <label for="email">{f.email.label}</label>
                <input type="email" id="email" name="email" required placeholder={f.email.placeholder}>
            </div>
        </div>
        <div class="form-group">
            <label for="phone">{f.phone.label}</label>
            <input type="tel" id="phone" name="phone" placeholder={f.phone.placeholder}>
        </div>
        <div class="form-group">
            <label for="message">{f.message.label}</label>
            <textarea id="message" name="message" required placeholder={f.message.placeholder}></textarea>
        </div>
        <Button type="submit" variant="primary" size="lg" block>{f.submit}</Button>
    </form>

</div>

<script>
    const form = document.getElementById('contactForm');
    form.addEventListener('submit', async function(e) {
        e.preventDefault();
        var btn = this.querySelector('button[type="submit"]');
        var originalHTML = btn.innerHTML;
        btn.disabled = true;
        btn.textContent = this.dataset.sending;

        try {
            var response = await fetch(this.action, {
                method: 'POST',
                body: new FormData(this),
                headers: { 'Accept': 'application/json' }
            });

            if (response.ok) {
                this.innerHTML = '<p class="form-success">&#10003; ' + this.dataset.successTitle + '<br><span>' + this.dataset.successText + '</span></p>';
            } else {
                throw new Error('err');
            }
        } catch (err) {
            btn.disabled = false;
            btn.innerHTML = originalHTML;
            alert(this.dataset.error);
        }
    });
</script>

<style>
    .contact-form {
        background: var(--color-surface);
        border-radius: var(--radius-lg);
        padding: var(--space-40);
        box-shadow: var(--shadow-md);
        transition: box-shadow var(--duration-base) var(--ease-standard);
    }
    .contact-form:hover { box-shadow: var(--shadow-lg); }
    .contact-form h3 { font-size: var(--text-xl); margin-bottom: var(--space-24); }
    .form-group { margin-bottom: var(--space-20); }
    .form-group label {
        display: block;
        font-weight: var(--fw-semibold);
        font-size: var(--text-sm);
        margin-bottom: var(--space-8);
        transition: color var(--duration-base) var(--ease-standard);
    }
    .form-group:focus-within label { color: var(--color-brand); }
    .form-group input,
    .form-group textarea {
        width: 100%;
        padding: var(--space-12) var(--space-16);
        border: 2px solid var(--color-border);
        border-radius: var(--radius-sm);
        font-family: inherit;
        font-size: var(--text-base);
        transition: all var(--duration-base) var(--ease-standard);
        background: var(--color-surface-alt);
    }
    .form-group input:focus,
    .form-group textarea:focus {
        outline: none;
        border-color: var(--color-brand);
        background: var(--color-surface);
        box-shadow: var(--focus-ring);
    }
    .form-group textarea { min-height: 120px; resize: vertical; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-16); }

    /* Shortcut to online booking */
    .booking-banner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: var(--space-12);
        background: var(--color-brand-subtle);
        border: 1px solid var(--color-brand-border);
        border-radius: var(--radius-md);
        padding: var(--space-12) var(--space-12) var(--space-12) var(--space-20);
        margin-bottom: var(--space-24);
    }
    .booking-banner-text { font-size: var(--text-sm); color: var(--color-text); }

    /* Thank-you note that replaces the form (inserted by the script, hence :global) */
    .contact-form :global(.form-success) { text-align: center; padding: var(--space-32) 0; font-size: var(--text-lg); color: var(--color-brand); font-weight: var(--fw-semibold); }
    .contact-form :global(.form-success span) { font-size: var(--text-sm); color: var(--color-text-muted); font-weight: var(--fw-regular); display: block; margin-top: var(--space-8); }

    @media (max-width: 768px) {
        .form-row { grid-template-columns: 1fr; }
    }
</style>
