---
// Message form. Sends to Formspree (address in src/data/site.json) without leaving the page,
// then replaces the form with a thank-you note. Above it: a shortcut to online booking.
import Button from '../Button.astro';
import { home, site } from '../../lib/content';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const { contact } = home;
const f = contact.form;
---
<div class:list={['contact-form', className]}>
    <a href={contact.bookingBanner.href} class="booking-banner">
        <span class="booking-banner-text">{contact.bookingBanner.text}</span>
        <span class="booking-banner-action">{contact.bookingBanner.action}</span>
    </a>
    <h3>{contact.formTitle}</h3>
    <form id="contactForm" action={site.formspree} method="POST" data-sending={f.sending} data-success-title={f.successTitle} data-success-text={f.successText} data-error={`${f.error} ${site.email}`}>
        <div class="form-row">
            <div class="form-group">
                <label for="name">{f.name.label}</label>
                <input type="text" id="name" name="name" required placeholder={f.name.placeholder}>
            </div>
            <div class="form-group">
                <label for="email">{f.email.label}</label>
                <input type="email" id="email" name="email" required placeholder={f.email.placeholder}>
            </div>
        </div>
        <div class="form-group">
            <label for="phone">{f.phone.label}</label>
            <input type="tel" id="phone" name="phone" placeholder={f.phone.placeholder}>
        </div>
        <div class="form-group">
            <label for="message">{f.message.label}</label>
            <textarea id="message" name="message" required placeholder={f.message.placeholder}></textarea>
        </div>
        <Button type="submit" variant="primary" size="lg" block>{f.submit}</Button>
    </form>

</div>

<script>
    const form = document.getElementById('contactForm');
    form.addEventListener('submit', async function(e) {
        e.preventDefault();
        var btn = this.querySelector('button[type="submit"]');
        var originalHTML = btn.innerHTML;
        btn.disabled = true;
        btn.textContent = this.dataset.sending;

        try {
            var response = await fetch(this.action, {
                method: 'POST',
                body: new FormData(this),
                headers: { 'Accept': 'application/json' }
            });

            if (response.ok) {
                this.innerHTML = '<p style="text-align:center;padding:32px 0;font-size:17px;color:#7C3AED;font-weight:600;">&#10003; ' + this.dataset.successTitle + '<br><span style="font-size:14px;color:#4B5563;font-weight:400;display:block;margin-top:8px;">' + this.dataset.successText + '</span></p>';
            } else {
                throw new Error('err');
            }
        } catch (err) {
            btn.disabled = false;
            btn.innerHTML = originalHTML;
            alert(this.dataset.error);
        }
    });
</script>

<style>
    .contact-form {
        background: var(--white);
        border-radius: 20px;
        padding: 40px;
        box-shadow: 0 4px 24px rgba(15,15,26,0.08);
        transition: box-shadow 0.3s ease;
    }
    .contact-form:hover { box-shadow: 0 8px 40px rgba(15,15,26,0.12); }
    .contact-form h3 { font-size: 20px; margin-bottom: 24px; }
    .form-group { margin-bottom: 20px; }
    .form-group label {
        display: block;
        font-weight: 600;
        font-size: 14px;
        margin-bottom: 8px;
        transition: color 0.3s ease;
    }
    .form-group:focus-within label { color: var(--primary); }
    .form-group input,
    .form-group textarea {
        width: 100%;
        padding: 14px 18px;
        border: 2px solid var(--gray-200);
        border-radius: 10px;
        font-family: inherit;
        font-size: 15px;
        transition: all 0.3s ease;
        background: var(--bg);
    }
    .form-group input:focus,
    .form-group textarea:focus {
        outline: none;
        border-color: var(--primary);
        background: var(--white);
        box-shadow: 0 0 0 4px rgba(124, 58, 237, 0.1);
    }
    .form-group textarea { min-height: 120px; resize: vertical; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }

    /* Shortcut to online booking */
    .booking-banner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: var(--soft);
        border: 1.5px solid rgba(124,58,237,0.2);
        border-radius: 50px;
        padding: 14px 20px 14px 24px;
        margin-bottom: 24px;
        text-decoration: none;
        transition: all 0.3s ease;
    }
    .booking-banner:hover {
        background: #ede0ff;
        border-color: var(--primary);
    }
    .booking-banner-text { font-size: 14px; color: var(--dark); }
    .booking-banner-action {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: var(--primary);
        color: #fff;
        font-size: 13px;
        font-weight: 600;
        padding: 8px 16px;
        border-radius: 50px;
        white-space: nowrap;
    }

    @media (max-width: 768px) {
        .form-row { grid-template-columns: 1fr; }
    }
</style>
