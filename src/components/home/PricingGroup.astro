---
// Wide price strip (group trainings): icon, title, description and one price.
import Icon from '../Icon.astro';
import type { IconName } from '../icons';
import { price as formatPrice } from '../../lib/content';

interface Props {
  icon: IconName;
  title: string;
  description: string;
  price: number;
  unit: string;
  class?: string;
}

const { icon, title, description, price, unit, class: className } = Astro.props;
---
<div class:list={['pricing-group', className]}>
    <div class="pricing-group-content">
        <div class="pricing-group-title">
            <div class="pricing-group-icon">
                <Icon name={icon} />
            </div>
            <div>
                <h3>{title}</h3>
                <p>{description}</p>
            </div>
        </div>
        <div class="pricing-group-price">
            <span class="price">{formatPrice(price)}</span>
            <span class="per">{unit}</span>
        </div>
    </div>
</div>

<style>
    .pricing-group {
        background: var(--soft);
        border-radius: var(--radius-16);
        padding: var(--space-32);
        margin-bottom: var(--space-24);
    }
    .pricing-group-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: var(--space-16);
    }
    .pricing-group-title {
        display: flex;
        align-items: center;
        gap: var(--space-16);
    }
    .pricing-group-icon {
        width: 44px;
        height: 44px;
        background: var(--white);
        border-radius: var(--radius-10);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .pricing-group-icon svg {
        width: 22px;
        height: 22px;
        color: var(--primary);
    }
    .pricing-group h3 {
        font-size: var(--fs-20);
        margin-bottom: var(--space-8);
    }
    .pricing-group p {
        color: var(--gray-600);
        font-size: var(--fs-15);
        margin: 0;
    }
    .pricing-group-price {
        text-align: right;
        white-space: nowrap;
    }
    .pricing-group-price .price {
        font-family: var(--font-heading);
        font-size: var(--fs-32);
        font-weight: var(--fw-bold);
        color: var(--primary);
        display: block;
    }
    .pricing-group-price .per {
        font-size: var(--fs-14);
        color: var(--gray-600);
    }

    @media (max-width: 900px) {
        .pricing-group-content { flex-direction: column; text-align: center; }
        .pricing-group-title { flex-direction: column; }
        .pricing-group-icon { margin: 0 auto; }
        .pricing-group-price { text-align: center; }
    }
    @media (max-width: 768px) {
        .pricing-group { padding: var(--space-24); }
        .pricing-group-title { text-align: center; }
        .pricing-group-icon { margin: 0 auto var(--space-12); }
    }
</style>
