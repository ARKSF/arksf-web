---
// Fixed top bar on every page: logo (home), page links with the current page marked,
// Rezervace button, scroll progress, phone menu.
import Logo from './Logo.astro';
import Button from './Button.astro';
import nav from '../data/nav.json';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path.endsWith(`/${href}`) || path.endsWith(`/${href.replace('.html', '')}`);
---
<nav class="navbar">
    <div class="progress-bar" id="progressBar"></div>
    <div class="container navbar-inner">
        <a href="index.html" class="logo-wrap" aria-label="ARK – úvod">
            <Logo class="logo-svg" />
        </a>
        <ul class="nav-menu">
            {nav.pages.map((p) => <li><a href={p.href} class="nav-link" aria-current={isCurrent(p.href) ? 'page' : undefined}>{p.label}</a></li>)}
            <li><Button href={nav.booking.href} variant="secondary" size="sm">{nav.booking.label}</Button></li>
        </ul>
        <button class="nav-toggle" data-menu-toggle aria-label="Menu" aria-controls="mobileNav">
            <span></span><span></span><span></span>
        </button>
    </div>
</nav>

<div class="mobile-nav" id="mobileNav">
    <div class="mobile-nav-header">
        <a href="index.html" aria-label="ARK – úvod"><Logo class="logo-svg" /></a>
        <button class="mobile-nav-close" data-menu-toggle aria-label="Zavřít menu">×</button>
    </div>
    <ul class="mobile-nav-menu">
        <li><a href="index.html" aria-current={path === '/' || path.endsWith('/index.html') ? 'page' : undefined}>Úvod</a></li>
        {nav.pages.map((p) => <li><a href={p.href} aria-current={isCurrent(p.href) ? 'page' : undefined}>{p.label}</a></li>)}
    </ul>
    <Button href={nav.booking.href} variant="primary" block>{nav.booking.label}</Button>
</div>

<script>
    // Phone menu
    const mobileNav = document.getElementById('mobileNav');
    function toggleMobileMenu() {
        mobileNav.classList.toggle('active');
        document.body.style.overflow = mobileNav.classList.contains('active') ? 'hidden' : '';
    }
    document.querySelectorAll('[data-menu-toggle]').forEach((el) => el.addEventListener('click', toggleMobileMenu));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && mobileNav.classList.contains('active')) toggleMobileMenu(); });

    // Progress bar and shadow
    const navbar = document.querySelector('.navbar');
    const progressBar = document.getElementById('progressBar');
    window.addEventListener('scroll', () => {
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        progressBar.style.width = (docHeight > 0 ? (window.scrollY / docHeight) * 100 : 0) + '%';
        navbar.style.boxShadow = window.scrollY > 50 ? 'var(--shadow-sm)' : 'none';
    }, { passive: true });
</script>

<style>
    .navbar {
        position: fixed;
        top: 0; left: 0; right: 0;
        z-index: var(--z-header);
        background: var(--color-header);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-bottom: 1px solid var(--color-border-subtle);
    }
    .navbar-inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        height: var(--header-height);
    }
    .progress-bar {
        position: absolute;
        bottom: 0;
        left: 0;
        height: 3px;
        background: linear-gradient(90deg, var(--color-brand), var(--color-accent));
        width: 0%;
        transition: width var(--duration-fast) var(--ease-standard);
    }
    .logo-wrap { display: flex; transition: transform var(--duration-base) var(--ease-standard); }
    .logo-wrap:hover { transform: scale(1.02); }
    .logo-svg { height: 28px; width: auto; display: block; }
    .nav-menu {
        display: flex;
        align-items: center;
        gap: var(--space-32);
        list-style: none;
    }
    .nav-link {
        font-weight: var(--fw-medium);
        font-size: var(--text-base);
        color: var(--color-text);
        transition: color var(--duration-base) var(--ease-standard);
        position: relative;
    }
    .nav-link::after {
        content: '';
        position: absolute;
        bottom: -4px;
        left: 0;
        width: 0;
        height: 2px;
        background: var(--color-brand);
        transition: width var(--duration-base) var(--ease-standard);
    }
    .nav-link:hover, .nav-link[aria-current="page"] { color: var(--color-brand); }
    .nav-link:hover::after, .nav-link[aria-current="page"]::after { width: 100%; }
    .nav-toggle {
        display: none;
        flex-direction: column;
        gap: var(--space-4);
        background: none;
        border: none;
        cursor: pointer;
        padding: var(--space-8);
    }
    .nav-toggle span { width: 24px; height: 2px; background: var(--color-surface-inverse); }

    /* Phone menu */
    .mobile-nav {
        display: none;
        position: fixed;
        inset: 0;
        background: var(--color-surface);
        z-index: var(--z-overlay);
        padding: var(--space-24);
        flex-direction: column;
    }
    .mobile-nav.active { display: flex; }
    .mobile-nav-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: var(--space-48);
    }
    .mobile-nav-close {
        background: none;
        border: none;
        font-size: var(--text-3xl);
        cursor: pointer;
        line-height: var(--leading-none);
        color: var(--color-text);
    }
    .mobile-nav-menu { list-style: none; flex: 1; }
    .mobile-nav-menu li { margin-bottom: var(--space-24); }
    .mobile-nav-menu a {
        font-family: var(--font-heading);
        font-size: var(--text-2xl);
        font-weight: var(--fw-semibold);
    }
    .mobile-nav-menu a[aria-current="page"] { color: var(--color-brand); }

    @media (max-width: 768px) {
        .nav-menu { display: none; }
        .nav-toggle { display: flex; }
    }
</style>
