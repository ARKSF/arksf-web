---
// Photo from src/assets/photos/ (file name, usually taken from src/data/photos.json), resized by Astro.
// Without a file it draws a placeholder frame with `label`, so layouts can be built before the photos arrive.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';

interface Props {
  file?: string;
  alt: string;
  /** Label of the placeholder frame, e.g. "Foto: skupinová lekce". */
  label?: string;
  /** CSS aspect ratio, e.g. "4 / 3". */
  ratio?: string;
  sizes?: string;
  widths?: number[];
  eager?: boolean;
  class?: string;
}

const { file, alt, label = alt, ratio = '4 / 3', sizes = '(max-width: 900px) 100vw, 560px', widths = [480, 720, 960, 1280], eager = false, class: className } = Astro.props;
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.{jpg,jpeg,png,webp,avif}', { eager: true });
let img: ImageMetadata | undefined;
if (file) {
  const hit = photos[`../assets/photos/${file}`];
  if (!hit) throw new Error(`Photo "${file}" not found in src/assets/photos/ (see src/data/photos.json)`);
  img = hit.default;
}
---
<div class:list={['photo', !img && 'photo--empty', className]} style={`aspect-ratio: ${ratio};`}>
    {img
      ? <Image src={img} alt={alt} widths={widths} sizes={sizes} loading={eager ? 'eager' : 'lazy'} />
      : <div class="photo-placeholder" role="img" aria-label={alt}><Icon name="image" /><span>{label}</span></div>}
</div>

<style>
    .photo {
        position: relative;
        overflow: hidden;
        border-radius: var(--radius-lg);
        background: var(--color-brand-subtle);
    }
    .photo img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }
    .photo-placeholder {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: var(--space-8);
        color: var(--color-brand);
        font-family: var(--font-heading);
        font-size: var(--text-sm);
        font-weight: var(--fw-semibold);
        text-align: center;
        padding: var(--space-16);
        border: 2px dashed var(--color-brand-border);
        border-radius: inherit;
    }
    .photo-placeholder :global(svg) { width: 32px; height: 32px; opacity: 0.6; }
</style>
