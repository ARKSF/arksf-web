---
// Site footer, the same on every page. Links come from src/data/nav.json.
import LogoExtended from './LogoExtended.astro';
import Icon from './Icon.astro';
import site from '../data/site.json';
import nav from '../data/nav.json';
---
<footer class="footer">
    <div class="container">
        <div class="footer-grid">
            <div class="footer-brand">
                <LogoExtended class="logo-extended" />
                <p>{site.tagline}</p>
                <div class="footer-social">
                    <a href={site.instagram} target="_blank" rel="noopener" aria-label="Instagram">
                        <Icon name="instagram" />
                    </a>
                </div>
            </div>
            <div class="footer-nav-columns">
                <div>
                    <h4>Navigace</h4>
                    <ul class="footer-links">
                        {nav.footerLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
                    </ul>
                </div>
                <div>
                    <h4>Pro klienty</h4>
                    <ul class="footer-links">
                        {nav.clientLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
                    </ul>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <p>{site.copyright}</p>
            <p>{site.address.full}</p>
            <p><a href={site.phone.href}>{site.phone.display}</a></p>
            <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
            <p>jednatel {site.director}</p>
            <p><a href={site.credit.url} target="_blank" rel="noopener" class="footer-credit">{site.credit.label}</a></p>
        </div>
    </div>
</footer>

<style>
    .footer {
        background: var(--color-surface-inverse);
        color: var(--color-text-inverse);
        padding: var(--space-64) 0 var(--space-24);
    }
    .footer-grid {
        display: grid;
        grid-template-columns: 1.5fr 1fr;
        gap: var(--space-48);
        margin-bottom: var(--space-48);
    }
    .footer-nav-columns {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-32);
    }
    .footer-brand .logo-extended {
        height: 56px;
        width: auto;
        margin-bottom: var(--space-20);
    }
    .footer-brand > p {
        color: var(--color-text-inverse-muted);
        font-size: var(--text-base);
        max-width: 300px;
        line-height: var(--leading-relaxed);
    }
    .footer-social { display: flex; gap: var(--space-12); margin-top: var(--space-24); }
    .footer-social a {
        width: 40px; height: 40px;
        background: var(--color-fill-inverse);
        border-radius: var(--radius-sm);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all var(--duration-base) var(--ease-standard);
    }
    .footer-social a:hover {
        background: var(--color-brand);
        transform: translateY(-4px);
    }
    .footer-social :global(svg) {
        width: 18px; height: 18px;
        color: var(--color-text-inverse);
    }
    .footer h4 { font-size: var(--text-sm); margin-bottom: var(--space-16); }
    .footer-links { list-style: none; }
    .footer-links li { margin-bottom: var(--space-8); }
    .footer-links a {
        color: var(--color-text-inverse-muted);
        font-size: var(--text-sm);
        transition: all var(--duration-base) var(--ease-standard);
        display: inline-block;
    }
    .footer-links a:hover {
        color: var(--color-accent);
        transform: translateX(4px);
    }
    .footer-bottom {
        padding-top: var(--space-24);
        border-top: 1px solid var(--color-border-inverse);
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: var(--space-8) var(--space-24);
        text-align: center;
    }
    .footer-bottom p { color: var(--color-text-inverse-muted); font-size: var(--text-sm); }
    .footer-credit { color: inherit; text-decoration: underline; text-underline-offset: 2px; }

    @media (max-width: 900px) {
        .footer-grid { grid-template-columns: 1fr; gap: var(--space-40); }
    }
</style>
