---
// Centred header of a subpage: "// label", h1, one line of text.
// size="lg" (booking page) or "md" (terms page): the two pages had different header sizes.
interface Props {
  label: string;
  title: string;
  text: string;
  size?: 'lg' | 'md';
}
const { label, title, text, size = 'lg' } = Astro.props;
---
<div class:list={['page-header', `page-header--${size}`]}>
    <span class="section-label">{label}</span>
    <h1>{title}</h1>
    <p>{text}</p>
</div>

<style>
    .page-header { text-align: center; }
    .page-header .section-label { display: block; margin-bottom: var(--space-12); }
    .page-header h1 { margin-bottom: var(--space-16); }
    .page-header p { color: var(--color-text-muted); font-size: var(--text-lg); }

    .page-header--lg { margin-bottom: var(--space-section-header); }
    .page-header--lg h1 { font-size: var(--text-h1); }
    .page-header--lg p { max-width: 500px; margin: 0 auto; }

    .page-header--md { margin-bottom: var(--space-section-header); }
    .page-header--md h1 { font-size: var(--text-h1); }
</style>
