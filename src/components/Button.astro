---
// Button or button-styled link. Renders <a> when `href` is set, otherwise <button>.
//
// variant: primary   filled violet (main call to action, has the light sweep)
//          secondary violet outline
//          soft      light violet fill, violet text
//          accent    coral fill, white text (on dark panels)
// size:    sm (40 px) | md (48 px) | lg (56 px)
// block:   fills the container width; blockOnMobile: only below 768 px
// Icons go in the slot after the label (<Icon name="arrow-right" />).
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'soft' | 'accent';
  size?: 'sm' | 'md' | 'lg';
  block?: boolean;
  blockOnMobile?: boolean;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  [key: string]: unknown;
}

const { href, variant = 'primary', size = 'md', block = false, blockOnMobile = false, type = 'button', class: className, ...rest } = Astro.props;
const classes = [
  'btn',
  `btn--${variant}`,
  `btn--${size}`,
  block && 'btn--block',
  blockOnMobile && 'btn--block-mobile',
  className,
];
---
{href
  ? <a href={href} class:list={classes} {...rest}><slot /></a>
  : <button type={type} class:list={classes} {...rest}><slot /></button>}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-8);
    font-family: var(--font-heading);
    font-weight: var(--fw-semibold);
    line-height: var(--leading-none);
    white-space: nowrap;
    border-radius: var(--radius-sm);
    border: 2px solid transparent;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    transition: all var(--duration-base) var(--ease-standard);
  }
  .btn:hover { transform: translateY(-2px); }
  .btn:focus-visible { outline: none; box-shadow: var(--focus-ring); }
  .btn :global(svg) { width: 18px; height: 18px; transition: transform var(--duration-base) var(--ease-standard); }
  .btn:hover :global(svg) { transform: translateX(4px); }

  /* Sizes */
  .btn--sm { height: 40px; padding: 0 var(--space-16); font-size: var(--text-sm); }
  .btn--md { height: 48px; padding: 0 var(--space-24); font-size: var(--text-base); }
  .btn--lg { height: 56px; padding: 0 var(--space-32); font-size: var(--text-base); }
  .btn--block { width: 100%; }

  /* Variants */
  .btn--primary {
    background: var(--color-brand);
    border-color: var(--color-brand);
    color: var(--color-text-inverse);
  }
  .btn--primary:hover {
    background: var(--color-brand-hover);
    border-color: var(--color-brand-hover);
    box-shadow: var(--shadow-brand);
  }
  /* Light sweep: primary only */
  .btn--primary::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, var(--color-sheen), transparent);
    transition: left var(--duration-slow) var(--ease-standard);
  }
  .btn--primary:hover::before { left: 100%; }

  .btn--secondary {
    background: transparent;
    border-color: var(--color-brand);
    color: var(--color-brand);
  }
  .btn--secondary:hover {
    background: var(--color-brand);
    color: var(--color-text-inverse);
  }

  .btn--soft {
    background: var(--color-brand-subtle);
    border-color: var(--color-brand-subtle);
    color: var(--color-brand);
  }
  .btn--soft:hover {
    background: var(--color-brand);
    border-color: var(--color-brand);
    color: var(--color-text-inverse);
  }

  .btn--accent {
    background: var(--color-accent-strong);
    border-color: var(--color-accent-strong);
    color: var(--color-text-inverse);
  }
  .btn--accent:hover {
    background: var(--color-accent-strong-hover);
    border-color: var(--color-accent-strong-hover);
    box-shadow: var(--shadow-accent);
  }

  @media (max-width: 768px) {
    .btn--block-mobile { width: 100%; }
  }
</style>
