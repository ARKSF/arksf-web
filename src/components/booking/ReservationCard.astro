---
// Booking page card: icon, title, text and one action (slot).
import Icon from '../Icon.astro';
import type { IconName } from '../icons';

interface Props {
  icon: IconName;
  title: string;
  text: string;
}
const { icon, title, text } = Astro.props;
---
<div class="card">
    <div class="card-icon">
        <Icon name={icon} />
    </div>
    <div class="card-content">
        <h3>{title}</h3>
        <p>{text}</p>
    </div>
    <div class="card-action">
        <slot />
    </div>
</div>

<style>
    .card { background: var(--white); border: 1px solid var(--gray-200); border-radius: 20px; padding: 32px; display: flex; align-items: center; gap: 24px; transition: all .3s ease; }
    .card:hover { border-color: var(--primary); box-shadow: 0 8px 30px rgba(124,58,237,0.1); transform: translateY(-4px); }
    .card-icon { width: 64px; height: 64px; background: var(--soft); border-radius: 16px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: all .3s ease; }
    .card:hover .card-icon { background: var(--primary); }
    .card-icon svg { width: 28px; height: 28px; color: var(--primary); transition: color .3s ease; }
    .card:hover .card-icon svg { color: var(--white); }
    .card-content { flex: 1; }
    .card-content h3 { font-size: 20px; margin-bottom: 8px; }
    .card-content p { color: var(--gray-600); font-size: 15px; margin: 0; }
    .card-action { flex-shrink: 0; }

    @media (max-width: 768px) {
        .card { flex-direction: column; text-align: center; }
        .card-action { width: 100%; }
    }
</style>
