---
// Booking page card: icon, title, text and one action (slot).
import Icon from '../Icon.astro';
import type { IconName } from '../icons';

interface Props {
  icon: IconName;
  title: string;
  text: string;
}
const { icon, title, text } = Astro.props;
---
<div class="card">
    <div class="card-icon">
        <Icon name={icon} />
    </div>
    <div class="card-content">
        <h3>{title}</h3>
        <p>{text}</p>
    </div>
    <div class="card-action">
        <slot />
    </div>
</div>

<style>
    .card { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-32); display: flex; align-items: center; gap: var(--space-24); transition: all var(--duration-base) var(--ease-standard); }
    .card:hover { border-color: var(--color-brand); box-shadow: var(--shadow-md); transform: translateY(-4px); }
    .card-icon { width: 64px; height: 64px; background: var(--color-brand-subtle); border-radius: var(--radius-lg); display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: all var(--duration-base) var(--ease-standard); }
    .card:hover .card-icon { background: var(--color-brand); }
    .card-icon svg { width: 28px; height: 28px; color: var(--color-brand); transition: color var(--duration-base) var(--ease-standard); }
    .card:hover .card-icon svg { color: var(--color-text-inverse); }
    .card-content { flex: 1; }
    .card-content h3 { font-size: var(--text-xl); margin-bottom: var(--space-8); }
    .card-content p { color: var(--color-text-muted); font-size: var(--text-base); margin: 0; }
    .card-action { flex-shrink: 0; }

    @media (max-width: 768px) {
        .card { flex-direction: column; text-align: center; }
        .card-action { width: 100%; }
    }
</style>
