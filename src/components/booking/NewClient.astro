---
// Dark call-out for people who are not clients yet: opens the booking window.
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import { booking, site } from '../../lib/content';
const n = booking.newClient;
---
<div class="new-client">
    <div class="new-client-content">
        <span class="new-client-label">{n.label}</span>
        <h3>{n.title}</h3>
        <p>{n.text} <a href={`mailto:${site.email}`} class="new-client-mail">{site.email}</a></p>
    </div>
    <Button variant="accent" size="card" class="new-client-btn" data-open-booking>{n.action} <Icon name="arrow-right" strokeWidth="2.5" /></Button>
</div>

<style>
    .new-client { max-width: 900px; margin: 0 auto; background: var(--dark); border-radius: 24px; padding: 48px; display: flex; align-items: center; justify-content: space-between; gap: 32px; position: relative; overflow: hidden; }
    .new-client::before { content: ''; position: absolute; top: -50%; right: -20%; width: 400px; height: 400px; background: radial-gradient(circle,rgba(124,58,237,0.3) 0%,transparent 70%); pointer-events: none; }
    .new-client-content { position: relative; z-index: 1; }
    .new-client-label { font-family: 'Space Grotesk', sans-serif; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: .15em; color: var(--accent); margin-bottom: 12px; display: block; }
    .new-client h3 { color: var(--white); font-size: 24px; margin-bottom: 8px; }
    .new-client p { color: rgba(255,255,255,0.6); font-size: 15px; margin: 0; }
    .new-client-mail { color: var(--accent); text-decoration: underline; }
    .new-client .new-client-btn { position: relative; z-index: 1; flex-shrink: 0; }
    .new-client-actions { display: flex; gap: 16px; flex-shrink: 0; position: relative; z-index: 1; }

    @media (max-width: 768px) {
        .new-client { flex-direction: column; text-align: center; padding: 40px 24px; }
        .new-client-actions { flex-direction: column; width: 100%; }
    }
</style>
