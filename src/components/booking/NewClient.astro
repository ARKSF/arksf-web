---
// Dark call-out for people who are not clients yet: opens the booking window.
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import { booking, site } from '../../lib/content';
const n = booking.newClient;
---
<div class="new-client">
    <div class="new-client-content">
        <span class="new-client-label">{n.label}</span>
        <h3>{n.title}</h3>
        <p>{n.text} <a href={`mailto:${site.email}`} class="new-client-mail">{site.email}</a></p>
    </div>
    <Button variant="accent" blockOnMobile class="new-client-btn" data-open-booking>{n.action} <Icon name="arrow-right" strokeWidth="2.5" /></Button>
</div>

<style>
    .new-client { max-width: 900px; margin: 0 auto; background: var(--color-surface-inverse); border-radius: var(--radius-xl); padding: var(--space-48); display: flex; align-items: center; justify-content: space-between; gap: var(--space-32); position: relative; overflow: hidden; }
    .new-client::before { content: ''; position: absolute; top: -50%; right: -20%; width: 400px; height: 400px; background: radial-gradient(circle,var(--color-brand-glow) 0%,transparent 70%); pointer-events: none; }
    .new-client-content { position: relative; z-index: var(--z-raised); }
    .new-client-label { font-family: var(--font-heading); font-size: var(--text-xs); font-weight: var(--fw-semibold); text-transform: uppercase; letter-spacing: var(--tracking-label); color: var(--color-accent); margin-bottom: var(--space-12); display: block; }
    .new-client h3 { color: var(--color-text-inverse); font-size: var(--text-2xl); margin-bottom: var(--space-8); }
    .new-client p { color: var(--color-text-inverse-muted); font-size: var(--text-base); margin: 0; }
    .new-client-mail { color: var(--color-accent); text-decoration: underline; }
    .new-client .new-client-btn { position: relative; z-index: var(--z-raised); flex-shrink: 0; }

    @media (max-width: 768px) {
        .new-client { flex-direction: column; text-align: center; padding: var(--space-40) var(--space-24); }
    }
</style>
