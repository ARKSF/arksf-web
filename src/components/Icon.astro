---
// Inline line icon. `round={false}` draws square line ends (the marquee icons use that).
import { icons, type IconName } from './icons';

interface Props {
  name: IconName;
  class?: string;
  strokeWidth?: number | string;
  round?: boolean;
}

const { name, class: className, strokeWidth = 2, round = true } = Astro.props;
const caps = round ? { 'stroke-linecap': 'round', 'stroke-linejoin': 'round' } : {};
---
<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth} {...caps} aria-hidden="true" set:html={icons[name]} />
