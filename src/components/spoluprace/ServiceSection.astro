---
// One way of working on the Spolupráce page: photo, who it is for, price rows and a booking button.
// Photo and text sides alternate (`flip`). Prices come from src/data/pricing.json via the page.
import Photo from '../Photo.astro';
import Badge from '../Badge.astro';
import Button from '../Button.astro';
import Icon from '../Icon.astro';

interface Props {
  id: string;
  label: string;
  title: string;
  description: string;
  forWhomLabel: string;
  forWhom: string[];
  photo?: string;
  photoLabel: string;
  badge?: string;
  footer?: string;
  bookLabel: string;
  flip?: boolean;
}
const { id, label, title, description, forWhomLabel, forWhom, photo, photoLabel, badge, footer, bookLabel, flip = false } = Astro.props;
---
<section class:list={['service', flip && 'service--flip']} id={id}>
    <div class="container service-grid">
        <div class="service-media reveal">
            <Photo file={photo} alt={title} label={photoLabel} ratio="4 / 5" sizes="(max-width: 900px) 100vw, 520px" widths={[480, 720, 1040]} />
        </div>
        <div class="service-content reveal delay-1">
            <span class="section-label">{label}</span>
            <div class="service-title">
                <h2>{title}</h2>
                {badge && <Badge dot>{badge}</Badge>}
            </div>
            <p class="service-desc">{description}</p>

            <h3 class="service-sub">{forWhomLabel}</h3>
            <ul class="service-for">
                {forWhom.map((line) => <li><Icon name="check" strokeWidth="2.5" /> {line}</li>)}
            </ul>

            <div class="service-prices">
                <slot />
                {footer && <p class="service-note">{footer}</p>}
            </div>

            <Button href="rezervace.html" variant="primary" blockOnMobile>{bookLabel} <Icon name="arrow-right" strokeWidth="2.5" /></Button>
        </div>
    </div>
</section>

<style>
    .service { padding: var(--space-section) 0; scroll-margin-top: var(--header-height); }
    .service:nth-of-type(even) { background: var(--color-surface); }
    .service-grid {
        display: grid;
        grid-template-columns: 1fr 1.1fr;
        gap: var(--space-64);
        align-items: center;
    }
    .service--flip .service-media { order: 2; }
    .service-media { position: sticky; top: calc(var(--header-height) + var(--space-24)); align-self: start; }
    .service-title { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-12) var(--space-16); margin-bottom: var(--space-16); }
    .service-title h2 { font-size: var(--text-h2); }
    .service-desc { font-size: var(--text-lg); color: var(--color-text-muted); margin-bottom: var(--space-32); }
    .service-sub {
        font-size: var(--text-xs);
        font-weight: var(--fw-semibold);
        text-transform: uppercase;
        letter-spacing: var(--tracking-label);
        color: var(--color-text-muted);
        margin-bottom: var(--space-12);
    }
    .service-for { list-style: none; display: grid; gap: var(--space-8); margin-bottom: var(--space-32); }
    .service-for li { display: flex; gap: var(--space-12); align-items: flex-start; }
    .service-for :global(svg) { width: 20px; height: 20px; color: var(--color-brand); flex-shrink: 0; margin-top: var(--space-4); }
    .service-prices {
        background: var(--color-surface-alt);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        padding: var(--space-8) var(--space-24);
        margin-bottom: var(--space-32);
    }
    .service:nth-of-type(odd) .service-prices { background: var(--color-surface); }
    .service-note { font-size: var(--text-sm); color: var(--color-text-muted); padding: var(--space-16) 0; border-top: 1px solid var(--color-border); }

    @media (max-width: 900px) {
        .service-grid { grid-template-columns: 1fr; gap: var(--space-32); }
        .service--flip .service-media { order: 0; }
        .service-media { position: static; max-width: 560px; }
    }
    @media (max-width: 768px) {
        .service { padding: var(--space-section-mobile) 0; }
    }
</style>
