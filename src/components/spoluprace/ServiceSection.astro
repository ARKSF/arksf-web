---
// One way of working on the Spolupráce page: photo, who it is for, a booking button and a link to
// the price list at the end of the page. Photo and text sides alternate (`flip`).
import Photo from '../Photo.astro';
import Button from '../Button.astro';
import Icon from '../Icon.astro';

interface Props {
  id: string;
  label: string;
  title: string;
  description: string;
  forWhomLabel: string;
  forWhom: string[];
  photo?: string;
  photoLabel: string;
  bookLabel: string;
  priceLabel: string;
  flip?: boolean;
}
const { id, label, title, description, forWhomLabel, forWhom, photo, photoLabel, bookLabel, priceLabel, flip = false } = Astro.props;
---
<section class:list={['service', flip && 'service--flip']} id={id}>
    <div class="container service-grid">
        <div class="service-media reveal">
            <Photo file={photo} alt={title} label={photoLabel} ratio="4 / 5" sizes="(max-width: 900px) 100vw, 520px" widths={[480, 720, 1040]} />
        </div>
        <div class="service-content reveal delay-1">
            <span class="section-label">{label}</span>
            <h2 class="service-title">{title}</h2>
            <p class="service-desc">{description}</p>

            <h3 class="service-sub">{forWhomLabel}</h3>
            <ul class="service-for">
                {forWhom.map((line) => <li><Icon name="check" strokeWidth="2.5" /> {line}</li>)}
            </ul>

            <div class="service-actions">
                <Button href="rezervace.html" variant="primary" blockOnMobile>{bookLabel} <Icon name="arrow-right" strokeWidth="2.5" /></Button>
                <a href="#cenik" class="service-price-link">{priceLabel}</a>
            </div>
        </div>
    </div>
</section>

<style>
    .service { padding: var(--space-section) 0; scroll-margin-top: var(--header-height); }
    .service:nth-of-type(even) { background: var(--color-surface); }
    .service-grid {
        display: grid;
        grid-template-columns: 1fr 1.1fr;
        gap: var(--space-64);
        align-items: center;
    }
    .service--flip .service-media { order: 2; }
    .service-media { position: sticky; top: calc(var(--header-height) + var(--space-24)); align-self: start; }
    .service-title { font-size: var(--text-h2); margin-bottom: var(--space-16); }
    .service-desc { font-size: var(--text-lg); color: var(--color-text-muted); margin-bottom: var(--space-32); }
    .service-sub {
        font-size: var(--text-xs);
        font-weight: var(--fw-semibold);
        text-transform: uppercase;
        letter-spacing: var(--tracking-label);
        color: var(--color-text-muted);
        margin-bottom: var(--space-12);
    }
    .service-for { list-style: none; display: grid; gap: var(--space-8); margin-bottom: var(--space-40); }
    .service-for li { display: flex; gap: var(--space-12); align-items: flex-start; }
    .service-for :global(svg) { width: 20px; height: 20px; color: var(--color-brand); flex-shrink: 0; margin-top: var(--space-4); }
    .service-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-16) var(--space-24); }
    .service-price-link { font-weight: var(--fw-semibold); color: var(--color-brand); text-decoration: underline; text-underline-offset: 3px; }
    .service-price-link:hover { color: var(--color-brand-hover); }

    @media (max-width: 900px) {
        .service-grid { grid-template-columns: 1fr; gap: var(--space-32); }
        .service--flip .service-media { order: 0; }
        .service-media { position: static; max-width: 560px; }
    }
    @media (max-width: 768px) {
        .service { padding: var(--space-section-mobile) 0; }
    }
</style>
