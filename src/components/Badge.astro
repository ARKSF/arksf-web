---
// Pill label. variant: default (pulsing coral dot) | dark (on dark sections) | hero (hero kicker).
interface Props {
  variant?: 'default' | 'dark' | 'hero';
  class?: string;
}

const { variant = 'default', class: className } = Astro.props;
---
<div class:list={['badge', variant !== 'default' && `badge-${variant}`, className]}><slot /></div>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    background: var(--white);
    color: var(--dark);
    padding: var(--space-10) var(--space-20);
    border-radius: var(--radius-pill);
    font-size: var(--fs-14);
    font-weight: var(--fw-medium);
    border: 1px solid var(--gray-200);
    transition: all var(--duration-300) ease;
  }
  .badge::before {
    content: '';
    width: 8px; height: 8px;
    background: var(--accent);
    border-radius: var(--radius-round);
    animation: pulse var(--duration-pulse) infinite;
  }
  .badge:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-badge);
  }
  .badge-dark {
    background: var(--white-a08);
    border-color: var(--white-a15);
    color: var(--white);
  }
  .badge-hero {
    display: inline-block;
    background: var(--white);
    color: var(--dark);
    border: 1px solid var(--gray-200);
    font-family: var(--font-heading);
    font-size: var(--fs-13);
    font-weight: var(--fw-semibold);
    padding: var(--space-8) var(--space-16);
    border-radius: var(--radius-20);
    margin-bottom: var(--space-24);
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.7; transform: scale(1.1); }
  }
</style>
