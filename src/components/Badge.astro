---
// Pill label. variant: default (pulsing coral dot) | dark (on dark sections) | hero (hero kicker).
interface Props {
  variant?: 'default' | 'dark' | 'hero';
  class?: string;
}

const { variant = 'default', class: className } = Astro.props;
---
<div class:list={['badge', variant !== 'default' && `badge-${variant}`, className]}><slot /></div>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--white);
    color: var(--dark);
    padding: 10px 20px;
    border-radius: 50px;
    font-size: 14px;
    font-weight: 500;
    border: 1px solid var(--gray-200);
    transition: all 0.3s ease;
  }
  .badge::before {
    content: '';
    width: 8px; height: 8px;
    background: var(--accent);
    border-radius: 50%;
    animation: pulse 2s infinite;
  }
  .badge:hover {
    border-color: var(--accent);
    box-shadow: 0 4px 12px rgba(255, 107, 107, 0.15);
  }
  .badge-dark {
    background: rgba(255,255,255,0.08);
    border-color: rgba(255,255,255,0.15);
    color: var(--white);
  }
  .badge-hero {
    display: inline-block;
    background: var(--white);
    color: var(--dark);
    border: 1px solid var(--gray-200);
    font-family: 'Space Grotesk', sans-serif;
    font-size: 13px;
    font-weight: 600;
    padding: 8px 16px;
    border-radius: 20px;
    margin-bottom: 24px;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.7; transform: scale(1.1); }
  }
</style>
