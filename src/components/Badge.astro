---
// Pill label.
// tone: light (white pill, on light sections) | dark (translucent pill, on dark sections)
// dot:  pulsing coral dot before the text
interface Props {
  tone?: 'light' | 'dark';
  dot?: boolean;
  class?: string;
}

const { tone = 'light', dot = false, class: className } = Astro.props;
---
<div class:list={['badge', `badge--${tone}`, dot && 'badge--dot', className]}><slot /></div>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    padding: var(--space-8) var(--space-16);
    border-radius: var(--radius-pill);
    border: 1px solid;
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: var(--fw-semibold);
    line-height: var(--leading-normal);
    transition: all var(--duration-base) var(--ease-standard);
  }
  .badge--light {
    background: var(--color-surface);
    border-color: var(--color-border);
    color: var(--color-text);
  }
  .badge--dark {
    background: var(--color-surface-inverse-raised-hover);
    border-color: var(--color-border-inverse);
    color: var(--color-text-inverse);
  }
  .badge--dot::before {
    content: '';
    width: 8px; height: 8px;
    background: var(--color-accent);
    border-radius: var(--radius-round);
    animation: pulse var(--duration-pulse) infinite;
  }
  .badge--dot:hover { border-color: var(--color-accent); }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.7; transform: scale(1.1); }
  }
</style>
