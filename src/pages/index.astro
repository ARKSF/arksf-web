---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import HomeHero from '../components/home/HomeHero.astro';
import Services from '../components/home/Services.astro';
import ServicePaths from '../components/home/ServicePaths.astro';
import About from '../components/home/About.astro';
import Reviews from '../components/home/Reviews.astro';
import Team from '../components/home/Team.astro';
import InstagramFeed from '../components/home/InstagramFeed.astro';
import Marquee from '../components/home/Marquee.astro';
import CtaBand from '../components/CtaBand.astro';
---
<Base
    description="Fyzioterapeuti, kteří vám vrátí vaši sílu zpět. Evidence-based fyzioterapie a osobní tréninky v Praze."
    path="/"
    layout="home"
>
    <Navbar />
    <main>
        <HomeHero />
        <Services />
        <ServicePaths />
        <About more />
        <Reviews />
        <Team preview />
        <InstagramFeed />
        <Marquee />
        <CtaBand />
    </main>
    <Footer />
</Base>
