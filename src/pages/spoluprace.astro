---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import Process from '../components/home/Process.astro';
import ServiceSection from '../components/spoluprace/ServiceSection.astro';
import Pricing from '../components/home/Pricing.astro';
import CtaBand from '../components/CtaBand.astro';
import { pages, pricing, photos, fill } from '../lib/content';

const page = pages.spoluprace;
const s = page.services;
const { consultations, trainings, group } = pricing;
const common = { forWhomLabel: page.forWhomLabel, bookLabel: page.bookAction };
---
<Base title="Spolupráce" description={page.description} path="/spoluprace.html">
    <Navbar />
    <main>
        <PageHero label={page.label} title={page.title} text={page.text} photo={photos.pages.spoluprace} photoAlt="Úvodní konzultace v ARK" />
        <Process part="steps" />

        <ServiceSection id="konzultace" tone="surface" {...common} label={s.konzultace.label} title={consultations.title} description={consultations.description}
            forWhom={s.konzultace.forWhom} photo={photos.konzultace} photoLabel={s.konzultace.photoLabel} />

        <ServiceSection id="treninky" tone="alt" flip {...common} label={s.treninky.label} title={trainings.title} description={trainings.description}
            forWhom={s.treninky.forWhom} photo={photos.treninky} photoLabel={s.treninky.photoLabel} />

        <ServiceSection id="skupinove" tone="surface" {...common} label={s.skupinove.label} title={group.title} description={fill(group.description)}
            forWhom={s.skupinove.forWhom} photo={photos.skupinove} photoLabel={s.skupinove.photoLabel} />

        <div class="price-wrap"><Pricing /></div>
        <div class="basics-wrap"><Process part="basics" /></div>
        <CtaBand />
    </main>
    <Footer />
</Base>

<style>
    .price-wrap :global(.pricing) { background: var(--color-surface-alt); }
    .price-wrap :global(.pricing-card:not(.featured)) { background: var(--color-surface); }
    .basics-wrap { background: var(--color-surface-alt); }
    .basics-wrap :global(.process--basics) { padding-top: 0; }
</style>
