---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Contact from '../components/home/Contact.astro';
import Photo from '../components/Photo.astro';
import { pages, photos } from '../lib/content';

const page = pages.kontakt;
---
<Base title="Kontakt" description={page.description} path="/kontakt.html">
    <Navbar />
    <main>
        <Contact asPageTitle />
        <section class="contact-photo">
            <div class="container">
                <Photo file={photos.kontakt} alt="ARK – Síla & Fyzio, Nademlejnská 651/7" label={page.photoLabel} ratio="21 / 9" sizes="(max-width: 1140px) 100vw, 1092px" widths={[640, 1092, 1600, 2184]} />
            </div>
        </section>
    </main>
    <Footer />
</Base>

<style>
    .contact-photo { padding-bottom: var(--space-section); }
</style>
