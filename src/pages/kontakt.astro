---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import Contact from '../components/home/Contact.astro';
import { pages, photos } from '../lib/content';

const page = pages.kontakt;
---
<Base title="Kontakt" description={page.description} path="/kontakt.html">
    <Navbar />
    <main>
        <PageHero label={page.label} title={page.title} text={page.text} photo={photos.pages.kontakt} photoAlt="Tým ARK – Síla & Fyzio" />
        <Contact />
    </main>
    <Footer />
</Base>
